<?xml version="1.0"?>
<opnsense>
  <theme>opnsense</theme>
  <system>
    <optimization>normal</optimization>
    <serialspeed>115200</serialspeed>
    <primaryconsole>serial</primaryconsole>
    <secondaryconsole>video</secondaryconsole>
    <disableconsolemenu/>
    <hostname>fsl-edge</hostname>
    <domain>range.internal</domain>
    <dnsallowoverride>0</dnsallowoverride>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <user>
      <name>root</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <password>*</password>
      <uid>0</uid>
      <shell>/bin/sh</shell>
      <authorizedkeys/>
    </user>
    <nextuid>2000</nextuid>
    <nextgid>2000</nextgid>
    <timezone>Etc/UTC</timezone>
    <webgui>
      <protocol>https</protocol>
      <noantilockout>1</noantilockout>
      <interfaces>opt1</interfaces>
    </webgui>
    <ssh>
      <enabled>enabled</enabled>
      <permitrootlogin>1</permitrootlogin>
      <group>admins</group>
    </ssh>
    <disablenatreflection>yes</disablenatreflection>
    <usevirtualterminal>1</usevirtualterminal>
    <disablechecksumoffloading>1</disablechecksumoffloading>
    <disablesegmentationoffloading>1</disablesegmentationoffloading>
    <disablelargereceiveoffloading>1</disablelargereceiveoffloading>
    <disablevlanhwfilter>1</disablevlanhwfilter>
    <pf_share_forward>1</pf_share_forward>
  </system>
  <interfaces>
    <wan>
      <descr>internet</descr>
      <enable>1</enable>
      <if>vtnet0</if>
      <mtu/>
      <ipaddr/>
      <subnet/>
    </wan>
    <lan>
      <descr>estate</descr>
      <enable>1</enable>
      <if>vtnet1</if>
      <mtu/>
      <ipaddr>dhcp</ipaddr>
      <subnet/>
    </lan>
    <opt1>
      <descr>mgmt</descr>
      <enable>1</enable>
      <if>vtnet2</if>
      <mtu/>
      <ipaddr>dhcp</ipaddr>
      <subnet/>
    </opt1>
    <lo0>
      <internal_dynamic>1</internal_dynamic>
      <descr>Loopback</descr>
      <enable>1</enable>
      <if>lo0</if>
      <ipaddr>127.0.0.1</ipaddr>
      <ipaddrv6>::1</ipaddrv6>
      <subnet>8</subnet>
      <subnetv6>128</subnetv6>
      <type>none</type>
      <virtual>1</virtual>
    </lo0>
  </interfaces>
  <virtualip/>
  <nat>
    <outbound>
      <mode>disabled</mode>
    </outbound>
  </nat>
  <filter>
    <rule>
      <type>block</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <quick>1</quick>
      <descr>fsl: the range never reaches the edge itself</descr>
      <source>
        <any/>
      </source>
      <destination>
        <network>(self)</network>
      </destination>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <quick>1</quick>
      <descr>fsl range crosses the edge</descr>
      <source>
        <any/>
      </source>
      <destination>
        <any/>
      </destination>
    </rule>
    <rule>
      <type>block</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <quick>1</quick>
      <descr>fsl: the estate never reaches the edge itself</descr>
      <source>
        <any/>
      </source>
      <destination>
        <network>(self)</network>
      </destination>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <quick>1</quick>
      <descr>fsl estate answers across the edge</descr>
      <source>
        <any/>
      </source>
      <destination>
        <any/>
      </destination>
    </rule>
    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <quick>1</quick>
      <descr>fsl the platform reaches the edge on management</descr>
      <source>
        <any/>
      </source>
      <destination>
        <any/>
      </destination>
    </rule>
  </filter>
  <OPNsense>
    <IDS>
      <general>
        <enabled>1</enabled>
        <ips>0</ips>
        <promisc>0</promisc>
        <interfaces>wan</interfaces>
        <homenet/>
        <syslog>0</syslog>
        <syslog_eve>0</syslog_eve>
        <LogPayload>0</LogPayload>
      </general>
    </IDS>
    <Syslog>
      <destinations/>
    </Syslog>
  </OPNsense>
</opnsense>
