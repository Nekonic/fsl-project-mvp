# FSL MVP baseline rules. The blue team edits this file from the console.
# sids live in the 9000000 range.

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL SQLi attempt - URI"; flow:established,to_server; http.uri; pcre:"/(\x27\s*(or|and)\s*[\x27\d]|union\s+select|--\s|\x27\s*--|\x27\s*\x29)/i"; sid:9000001; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL SQLi attempt - request body"; flow:established,to_server; http.request_body; pcre:"/(\x27\s*(or|and)\s*[\x27\d]|union\s+select|--\s|\x27\s*--)/i"; sid:9000002; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL XSS attempt - script tag or event handler"; flow:established,to_server; http.uri; pcre:"/(<script|%3cscript|javascript:|onerror\s*%?3?d?\s*=)/i"; sid:9000003; rev:1;)

# http.uri is the normalised buffer: %2F is decoded and dot segments are
# removed. Traversal has to be matched on the raw buffer. Verified live.
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL path traversal attempt"; flow:established,to_server; http.uri.raw; pcre:"/(\.\.(%2f|%5c|[\/\\])|%2e%2e)/i"; sid:9000004; rev:2;)
