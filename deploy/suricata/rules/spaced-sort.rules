# The baseline without sid 9000001, plus a signature for the board's sort
# parameter that expects SQL keywords between spaces. It matched about 1,700
# of 1,800 requests of each recorded stock sqlmap run and none of the tamper
# runs, whose spaces are comments (2026-10-13). The posture of scenario 3.3.
# The blue team edits this file from the console.
# sids are in the 9000000 range.
#
# Match whitespace in a query or form body with [\s+], not \s: a space sent
# as + is a space to the application but not to \s.

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL SQLi attempt - request body"; flow:established,to_server; http.request_body; pcre:"/(\x27[\s+]*(or|and)[\s+]*[\x27\d]|union[\s+]+select|--[\s+]|\x27[\s+]*--)/i"; classtype:web-application-attack; sid:9000002; rev:2;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL XSS attempt - script tag or event handler"; flow:established,to_server; http.uri; pcre:"/(<script|%3cscript|javascript:|onerror[\s+]*%?3?d?[\s+]*=)/i"; classtype:web-application-attack; sid:9000003; rev:2;)

# http.uri is normalised: %2F is decoded and dot segments are removed, so
# traversal is matched on the raw buffer.
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL path traversal attempt"; flow:established,to_server; http.uri.raw; pcre:"/(\.\.(%2f|%5c|[\/\\])|%2e%2e)/i"; classtype:web-application-attack; sid:9000004; rev:3;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"FSL SQLi attempt - SQL keyword in sort"; flow:established,to_server; http.uri; pcre:"/[?&]sort=[^&]*\s(and|or|select|where)\s/i"; classtype:web-application-attack; sid:9000101; rev:1;)
