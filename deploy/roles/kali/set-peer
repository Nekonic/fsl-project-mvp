#!/bin/sh
set -eu
peer=${1-}
allowed=${2-}
own=${3-}
ip link del wg0 2>/dev/null || :
[ -n "$peer" ] || exit 0
umask 077
key=$(mktemp)
trap 'rm -f "$key"' EXIT
cat > "$key"
ip link add wg0 type wireguard
wg set wg0 listen-port 51820 private-key "$key" peer "$peer" allowed-ips "$allowed"
ip addr add "$own" dev wg0
ip link set wg0 mtu 1360 up
