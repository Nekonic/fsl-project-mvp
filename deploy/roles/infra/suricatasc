#!/bin/sh
set -eu

RULE_FILE=/var/lib/suricata/rules/local.rules
ANALYST=analyst
SNAPSHOT=/var/lib/cr-reloaded/ids
PASSED=/var/lib/cr-reloaded/ids.passed

measured() {
  awk '{ if (rule == "" && $0 ~ /^[[:space:]]*#/) next; line = $0; if (sub(/\\[[:space:]]*$/, "", line)) { rule = rule line; next } print rule line; rule = "" } END { if (rule != "") print rule }' "$1" |
    grep -Eiq '[(;][[:space:]]*config[[:space:]]*:[[:space:]]*logging([^[:alnum:]_]|$)'
}

[ "$*" = "-c reload-rules" ] || exec docker exec -i sensor suricatasc "$@"
trap '' INT TERM HUP
exec 9>>"$SNAPSHOT.lock"
flock 9
staged=$(mktemp -d "$SNAPSHOT.new.XXXXXX")

handed_back() {
  setfacl -m "u:$ANALYST:rw" "$RULE_FILE"
  rm -rf "$staged"
}

trap handed_back EXIT
mkdir -p "$staged$(dirname "$RULE_FILE")"
cp "$RULE_FILE" "$staged$RULE_FILE"
if measured "$staged$RULE_FILE"; then
  echo "센서 로그를 끄는 룰(config: logging)이 있어 반영하지 않았습니다." >&2
  exit 1
fi
if ! grep -qxF "$(sha256sum < "$staged$RULE_FILE" | cut -d' ' -f1)" "$PASSED" 2>/dev/null; then
  echo "이번 라운드에서 테스트를 통과한 룰과 다릅니다. 콘솔에서 먼저 테스트하세요. 반영하지 않았습니다." >&2
  exit 1
fi
install -m 0644 -o root -g root "$staged$RULE_FILE" "$RULE_FILE.reloading"
mv "$RULE_FILE.reloading" "$RULE_FILE"
reply=$(docker exec -i sensor suricatasc -c reload-rules)
printf '%s\n' "$reply"
case "$(printf '%s' "$reply" | tr -d ' ')" in
  *'"return":"OK"'*) ;;
  *) exit 1 ;;
esac
date +%s.%N > "$staged/at"
rm -rf "$SNAPSHOT"
mv "$staged" "$SNAPSHOT"
