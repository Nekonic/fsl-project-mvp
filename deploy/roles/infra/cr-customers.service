[Unit]
Description=The slot's benign customers, sent from the plan the platform writes each round
After=network-online.target slot-boot.service
Requires=slot-boot.service
ConditionPathExists=/var/lib/cr-users/plan.json

[Service]
Type=simple
User=cr-users
Group=cr-users
WorkingDirectory=/var/lib/cr-users
ExecStart=/usr/bin/python3 /usr/local/lib/cr-users/customers.py /var/lib/cr-users/plan.json /var/lib/cr-users/records.jsonl
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=no
