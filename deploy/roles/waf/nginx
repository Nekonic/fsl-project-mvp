#!/bin/sh
set -eu

NGINX=/usr/sbin/nginx
PID=/run/nginx.pid
ANALYST=analyst
SNAPSHOT=/var/lib/cr-reloaded/waf
PASSED=/var/lib/cr-reloaded/waf.passed
CRS=/etc/nginx/modsecurity/crs
DEFENCE_FILES="$CRS/crs-setup.conf $CRS/rules/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf $CRS/rules/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf /etc/nginx/defence/http.conf /etc/nginx/defence/board.com.conf /etc/nginx/defence/corp.com.conf"

measured() {
  sed 's/#.*//' "$@" | grep -Eq '(^|[[:space:];{}])(access_log|log_format|error_log|open_log_file_cache|set_real_ip_from|real_ip_header|real_ip_recursive|include)([^[:alnum:]_]|$)' && return 0
  sed 's/#.*//' "$@" | grep -Eiq '(^|[^[:alnum:]_])(secaudit|secdebuglog|ctl:audit)|^[[:space:]]*include(optional)?([[:space:]]|$)'
}

refuse_measured() {
  if measured "$@"; then
    echo "플랫폼 로그 설정을 바꾸거나 다른 파일을 include하는 방어 파일이 있어 반영하지 않았습니다." >&2
    exit 1
  fi
}

loaded_sha() {
  for file in $DEFENCE_FILES; do
    printf '%s  %s\n' "$(sha256sum < "$1$file" | cut -d' ' -f1)" "$file"
  done | sha256sum | cut -d' ' -f1
}

refuse_untested() {
  if ! grep -qxF "$(loaded_sha "$1")" "$PASSED" 2>/dev/null; then
    echo "이번 라운드에서 테스트를 통과한 파일과 다릅니다. 콘솔에서 먼저 테스트하세요. 반영하지 않았습니다." >&2
    exit 1
  fi
}

case "$*" in
  "-s reload") ;;
  -t|-T) refuse_measured $DEFENCE_FILES; exec "$NGINX" "$@" ;;
  *) exec "$NGINX" "$@" ;;
esac
trap '' INT TERM HUP
exec 9>>"$SNAPSHOT.lock"
flock 9
staged=$(mktemp -d "$SNAPSHOT.new.XXXXXX")

handed_back() {
  for file in $DEFENCE_FILES; do
    chown root:"$ANALYST" "$file"
    chmod 0664 "$file"
  done
  rm -rf "$staged"
}

workers() {
  master=$(cat "$PID")
  for d in /proc/[0-9]*; do
    [ "$(cut -d' ' -f4 "$d/stat" 2>/dev/null)" = "$master" ] && echo "${d#/proc/}"
  done
  true
}

trap handed_back EXIT
for file in $DEFENCE_FILES; do
  mkdir -p "$staged$(dirname "$file")"
  cp "$file" "$staged$file"
  install -m 0644 -o root -g root "$staged$file" "$file.reloading"
  mv "$file.reloading" "$file"
done
refuse_measured $(for file in $DEFENCE_FILES; do echo "$staged$file"; done)
refuse_untested "$staged"
"$NGINX" -t
before=$(workers)
"$NGINX" -s reload
tries=0
until workers | grep -qvxF "$before"; do
  tries=$((tries + 1))
  [ "$tries" -lt 100 ] || { echo "nginx started no worker on the reloaded files" >&2; exit 1; }
  sleep 0.1
done
date +%s.%N > "$staged/at"
rm -rf "$SNAPSHOT"
mv "$staged" "$SNAPSHOT"
