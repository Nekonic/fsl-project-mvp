#!/bin/sh
set -eu

NGINX=/usr/sbin/nginx
PID=/run/nginx.pid
ANALYST=analyst
SNAPSHOT=/var/lib/cr-reloaded/waf
CRS=/etc/nginx/modsecurity/crs
DEFENCE_FILES="$CRS/crs-setup.conf $CRS/rules/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf $CRS/rules/RESPONSE-999-EXCLUSION-RULES-AFTER-CRS.conf /etc/nginx/defence/http.conf /etc/nginx/defence/board.com.conf /etc/nginx/defence/corp.com.conf"

[ "$*" = "-s reload" ] || exec "$NGINX" "$@"
trap '' INT TERM HUP
exec 9>>"$SNAPSHOT.lock"
flock 9
staged=$(mktemp -d "$SNAPSHOT.new.XXXXXX")

handed_back() {
  for file in $DEFENCE_FILES; do
    chown root:"$ANALYST" "$file"
    chmod 0664 "$file"
  done
  rm -rf "$staged"
}

workers() {
  master=$(cat "$PID")
  for d in /proc/[0-9]*; do
    [ "$(cut -d' ' -f4 "$d/stat" 2>/dev/null)" = "$master" ] && echo "${d#/proc/}"
  done
  true
}

trap handed_back EXIT
for file in $DEFENCE_FILES; do
  mkdir -p "$staged$(dirname "$file")"
  cp "$file" "$staged$file"
  install -m 0644 -o root -g root "$staged$file" "$file.reloading"
  mv "$file.reloading" "$file"
done
"$NGINX" -t
before=$(workers)
"$NGINX" -s reload
tries=0
until workers | grep -qvxF "$before"; do
  tries=$((tries + 1))
  [ "$tries" -lt 100 ] || { echo "nginx started no worker on the reloaded files" >&2; exit 1; }
  sleep 0.1
done
date +%s.%N > "$staged/at"
rm -rf "$SNAPSHOT"
mv "$staged" "$SNAPSHOT"
