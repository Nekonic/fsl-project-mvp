{
  "description": "FSL: attach geo information to the source IP. This is why there is no Logstash.",
  "processors": [
    {
      "geoip": {
        "field": "src_ip",
        "target_field": "src_geo",
        "ignore_missing": true,
        "on_failure": [
          {
            "set": {
              "field": "src_geo.error",
              "value": "lookup failed",
              "override": true
            }
          }
        ]
      }
    },
    {
      "geoip": {
        "field": "transaction.client_ip",
        "target_field": "src_geo",
        "ignore_missing": true,
        "on_failure": [
          {
            "set": {
              "field": "src_geo.error",
              "value": "lookup failed",
              "override": true
            }
          }
        ]
      }
    }
  ]
}
