{
  "description": "FSL: select evidence by event time, and attach geo information to the source IP. This is why there is no Logstash.",
  "processors": [
    {
      "date": {
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": ["yyyy-MM-dd'T'HH:mm:ss.SSSSSSZ", "ISO8601"],
        "if": "ctx.fsl_source == 'suricata' && ctx.timestamp != null"
      }
    },
    {
      "date": {
        "field": "transaction.time_stamp",
        "target_field": "@timestamp",
        "formats": ["EEE MMM  d HH:mm:ss yyyy", "EEE MMM d HH:mm:ss yyyy"],
        "if": "ctx.fsl_source == 'modsecurity' && ctx.transaction?.time_stamp != null"
      }
    },
    {
      "geoip": {
        "field": "src_ip",
        "target_field": "src_geo",
        "ignore_missing": true,
        "on_failure": [
          {
            "set": {
              "field": "src_geo.error",
              "value": "lookup failed",
              "override": true
            }
          }
        ]
      }
    },
    {
      "geoip": {
        "field": "transaction.client_ip",
        "target_field": "src_geo",
        "ignore_missing": true,
        "on_failure": [
          {
            "set": {
              "field": "src_geo.error",
              "value": "lookup failed",
              "override": true
            }
          }
        ]
      }
    }
  ]
}
