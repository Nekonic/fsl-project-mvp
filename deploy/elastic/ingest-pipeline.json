{
  "description": "FSL: 출발지 IP 의 지리 정보를 붙인다. Logstash 를 쓰지 않는 이유.",
  "processors": [
    {
      "geoip": {
        "field": "src_ip",
        "target_field": "src_geo",
        "ignore_missing": true,
        "on_failure": [
          {
            "set": {
              "field": "src_geo.error",
              "value": "lookup failed",
              "override": true
            }
          }
        ]
      }
    }
  ]
}
