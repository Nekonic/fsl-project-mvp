#!/usr/bin/env bash
set -euo pipefail

SEGMENTS=(
  "edge 5.188.10.0/24"
  "edge-br 177.54.144.0/24"
  "edge-hk 103.152.220.0/24"
  "edge-kp 175.45.176.0/24"
  "estate 172.30.0.0/24"
  "mgmt 172.31.0.0/24"
)
TAG=fsl.segment.id
IMAGE=${FSL_RANGE_IMAGE:-ubuntu-24.04}
FLAVOR=${FSL_RANGE_FLAVOR:-m1.small}
KEYPAIR=${FSL_RANGE_KEYPAIR:-fsl-claude}
PUBLIC_KEY=${FSL_RANGE_PUBLIC_KEY:-}
GROUP=fsl-sg
TARGET=fsl-juice-shop
TARGET_SEGMENT=estate

exists() {
  openstack "$@" -f value -c id >/dev/null 2>&1
}

up() {
  if ! exists keypair show "$KEYPAIR"; then
    [ -n "$PUBLIC_KEY" ] || { echo "set FSL_RANGE_PUBLIC_KEY to create keypair $KEYPAIR" >&2; exit 1; }
    openstack keypair create --public-key <(printf '%s\n' "$PUBLIC_KEY") "$KEYPAIR" >/dev/null
  fi

  if ! exists security group show "$GROUP"; then
    openstack security group create "$GROUP" >/dev/null
    for port in 22 80 3000; do
      openstack security group rule create --ingress --protocol tcp --dst-port "$port" "$GROUP" >/dev/null
    done
    openstack security group rule create --ingress --protocol icmp "$GROUP" >/dev/null
  fi

  for entry in "${SEGMENTS[@]}"; do
    read -r id cidr <<<"$entry"
    if ! exists network show "fsl-$id"; then
      openstack network create --tag "$TAG=$id" "fsl-$id" >/dev/null
    fi
    if ! exists subnet show "fsl-$id"; then
      openstack subnet create --network "fsl-$id" --subnet-range "$cidr" "fsl-$id" >/dev/null
    fi
  done

  if ! exists server show "$TARGET"; then
    openstack server create --image "$IMAGE" --flavor "$FLAVOR" \
      --key-name "$KEYPAIR" --security-group "$GROUP" \
      --network "fsl-$TARGET_SEGMENT" --config-drive true --wait "$TARGET" >/dev/null
  fi

  openstack network list --long -c Name -c Tags -c Subnets
  openstack server list -c Name -c Status -c Networks
}

down() {
  exists server show "$TARGET" && openstack server delete --wait "$TARGET"
  for entry in "${SEGMENTS[@]}"; do
    read -r id _ <<<"$entry"
    exists network show "fsl-$id" && openstack network delete "fsl-$id"
  done
  exists security group show "$GROUP" && openstack security group delete "$GROUP"
  exists keypair show "$KEYPAIR" && openstack keypair delete "$KEYPAIR"
  true
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  *) echo "usage: $0 up|down" >&2; exit 2 ;;
esac
