#!/usr/bin/env bash

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PY="$ROOT/.venv/bin/python"
FAST=0
CHANGED=0
LIVE=0
BASE=""
PLATFORM="${CR_PLATFORM_URL:-http://localhost:8000}"
export CR_PLATFORM_URL="$PLATFORM"
FAILED=0

case "${1:-}" in
  --fast) FAST=1 ;;
  --changed)
    CHANGED=1
    shift
    for argument in "$@"; do
      case "$argument" in
        --live) LIVE=1 ;;
        *) BASE="$argument" ;;
      esac
    done
    ;;
esac

UNIT_JOBS="${CR_UNIT_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)}"
[ "$UNIT_JOBS" -gt 4 ] && UNIT_JOBS=4
UNIT_NICE=""

unit_suite() {
  local dir n=0 code=0 file list
  dir="$(mktemp -d)"
  for file in $(cd platform && ls -S "$@"); do
    echo "$file" >> "$dir/$((n % UNIT_JOBS)).files"
    n=$((n + 1))
  done
  if [ "$n" = 0 ]; then
    echo "no unit test files among: $*"
    rm -rf "$dir"
    return 1
  fi
  for list in "$dir"/*.files; do
    (cd platform && $UNIT_NICE "$PY" -m pytest $(cat "$list") -q -p no:cacheprovider \
      > "${list%.files}.log" 2>&1; echo $? > "${list%.files}.code") &
  done
  wait
  for list in "$dir"/*.files; do
    if [ "$(cat "${list%.files}.code")" = 0 ]; then
      tail -1 "${list%.files}.log"
    else
      code=1
      cat "${list%.files}.log"
    fi
  done
  rm -rf "$dir"
  return "$code"
}

section() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail()    { printf '\033[31mFAIL\033[0m %s\n' "$1"; FAILED=1; }
ok()      { printf '\033[32mok\033[0m   %s\n' "$1"; }
stack_down() {
  fail "$1"
  echo
  echo "Skipping acceptance tests: the stack must be up."
  exit 1
}

if command -v uv >/dev/null && ! uv sync --quiet --frozen; then
  echo "uv sync --frozen failed: .venv does not match uv.lock"
  exit 1
fi
if [ ! -x "$PY" ]; then
  echo "No .venv: install uv, then run uv sync --frozen"
  exit 1
fi

if [ "$CHANGED" = 1 ]; then
  section "selection"
  PLAN="$(mktemp)"
  if ! "$PY" bin/select-tests ${BASE:+"$BASE"} --plan "$PLAN"; then
    fail "bin/select-tests crashed - run bin/verify --fast instead"
    exit 1
  fi
  unit_kind="$(sed -n 's/^unit //p' "$PLAN")"
  unit_files="$(sed -n 's/^unit-file //p' "$PLAN")"
  acceptance_kind="$(sed -n 's/^acceptance //p' "$PLAN")"
  acceptance_modules="$(sed -n 's/^acceptance-module //p' "$PLAN" | paste -sd, -)"
fi

if [ "$CHANGED" = 0 ] || [ "$unit_kind" != none ] || [ "$acceptance_kind" != none ]; then
  section "clients"
  if "$ROOT/bin/gen-clients"; then
    ok "openapi/schema.yaml exported, bots/client and front/src/api/schema.d.ts generated"
    if ! git diff --quiet -- openapi/schema.yaml 2>/dev/null; then
      echo "     openapi/schema.yaml changed: commit it with the change that moved it"
    fi
  else
    fail "bin/gen-clients could not export the schema or generate the clients"
    exit 1
  fi
fi

for layer in domain seams users telemetry scoring training contract; do
  if [ "$CHANGED" = 1 ] || [ ! -d "platform/tests/$layer" ]; then
    continue
  fi
  section "$layer tests"
  if layer_log="$(cd platform && "$PY" -m pytest "tests/$layer" -q -p no:cacheprovider 2>&1)"; then
    echo "$layer_log" | tail -1
    ok "platform/tests/$layer"
  else
    echo "$layer_log" | tail -40
    fail "platform/tests/$layer"
  fi
done

section "unit + API tests"
if [ "$CHANGED" = 1 ] && [ "$unit_kind" = none ]; then
  ok "no unit test reaches the change"
elif [ "$CHANGED" = 1 ] && [ "$unit_kind" = some ]; then
  if unit_suite $unit_files; then
    ok "platform/tests, the files the change reaches"
  else
    fail "platform/tests, the files the change reaches"
  fi
elif [ "$FAST" = 0 ] && [ "$CHANGED" = 0 ]; then
  UNIT_LOG="$(mktemp)"
  UNIT_NICE="nice -n 19"
  (unit_suite $(cd platform && ls tests/test_*.py) > "$UNIT_LOG" 2>&1; echo $? >> "$UNIT_LOG.code") &
  UNIT_PID=$!
  echo "running in $UNIT_JOBS processes beside the acceptance suite, at the lowest CPU priority"
elif unit_suite $(cd platform && ls tests/test_*.py); then
  ok "platform/tests"
else
  fail "platform/tests"
fi

front_reached() {
  [ "$CHANGED" = 0 ] && return 0
  [ -n "$(git status --porcelain -- front strings openapi 2>/dev/null)" ] && return 0
  [ -n "$BASE" ] && [ -n "$(git diff --name-only "$BASE" -- front strings openapi 2>/dev/null)" ] && return 0
  return 1
}

section "front end"
if ! command -v npm >/dev/null; then
  echo "front: no node here, so front/ was not built or tested"
elif ! front_reached; then
  ok "no file under front/, strings/ or openapi/ changed"
elif [ ! -d front/node_modules ] && ! (cd front && npm ci --no-audit --no-fund >/dev/null 2>&1); then
  fail "front: npm ci could not install front/package-lock.json"
else
  if front_log="$(cd front && npm run --silent types 2>&1 && npm run --silent build 2>&1)"; then
    ok "front/ type-checked and built into front/dist"
  else
    echo "$front_log" | tail -40
    fail "front/ build"
  fi
  if front_log="$(cd front && npx vitest run 2>&1)"; then
    echo "$front_log" | grep -E '^ +Tests ' | tail -1
    ok "front/ vitest"
  else
    echo "$front_log" | tail -40
    fail "front/ vitest"
  fi
fi

if [ "$FAST" = 1 ]; then
  [ "$FAILED" = 0 ] && printf '\n\033[32mfast check passed\033[0m — run bin/verify before committing\n'
  exit "$FAILED"
fi

live_acceptance() {
only="$1"
section "stack"
owner="$(docker inspect cr-platform --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null)"
if [ -z "$owner" ]; then
  stack_down 'cr-platform is not there — docker compose up -d --build'
fi
if [ "$(cd "$owner" 2>/dev/null && pwd -P)" != "$(pwd -P)" ]; then
  fail "the stack was brought up from $owner, not from $ROOT"
  echo "     restarting it would run that tree's code and call it this one's."
  echo "     Run bin/verify there, or, if nobody is using that stack,"
  echo '     docker compose up -d --build from here.'
  exit 1
fi
open_rounds="$("$PY" - <<'OPENCHECK' 2>/dev/null
import json, os, sys
sys.path.insert(0, os.getcwd())
from bots import signin
from bots.client.api.match import round_list
from bots.client.models import RoundListState
try:
    answer = round_list.sync_detailed(client=signin.signed_in(os.environ["CR_PLATFORM_URL"], 5),
                                      state=RoundListState.OPEN)
    rows = json.loads(answer.content) if answer.status_code == 200 else []
except Exception:
    sys.exit(0)
print(" ".join(str(row.get("round")) for row in rows if isinstance(row, dict)))
OPENCHECK
)"
if [ -n "$open_rounds" ]; then
  fail "a round is open (ids: $open_rounds)"
  echo "     bin/verify restarts the platform and prunes leases, which would"
  echo "     disrupt an open one. End it first, or wait for it to finish."
  exit 1
fi
if ! docker compose restart platform >/dev/null 2>&1; then
  stack_down 'platform could not be restarted — docker compose up -d --build'
fi
for _ in $(seq 60); do
  curl -fs -o /dev/null --max-time 5 "$PLATFORM/api/auth/csrf/" && break
  sleep 1
done
if curl -fsS -o /dev/null --max-time 5 "$PLATFORM/api/auth/csrf/"; then
  ok "platform restarted on the tree being verified"
else
  stack_down "platform not responding after a restart — docker compose logs platform"
fi

CR_ACCEPTANCE_LEASES="$(mktemp)"
export CR_ACCEPTANCE_LEASES

RULES_SAID="$(mktemp)"
opened="$("$PY" - "$RULES_SAID" <<'OPENSTACK'
import os, pathlib, sys
sys.path[:0] = [os.getcwd(), os.path.join(os.getcwd(), "test")]
import plays

def listed(played):
    with open(os.environ["CR_ACCEPTANCE_LEASES"], "a") as ids:
        ids.write(f"{played.lease}\n")

plays.LISTENERS.append(listed)
try:
    played = plays.play("board")
except Exception as error:
    print(error, file=sys.stderr)
    sys.exit(1)
print(played.lease)
try:
    checked = plays.check_ids(played, plays.declared_rules())
    said = "ok" if checked.ok and checked.body["ok"] else checked.text
except Exception as error:
    said = str(error)
pathlib.Path(sys.argv[1]).write_text(said)
closed = plays.close(played)
if not closed.ok:
    print(closed.text, file=sys.stderr)
    sys.exit(2)
OPENSTACK
)"
warmed=$?
if [ "$warmed" -eq 0 ]; then
  ok "lease $opened held a slot, its round started and the target is healthy"
elif [ "$warmed" -eq 2 ]; then
  fail "lease $opened held a slot but did not close (reason above);"
  echo "     the next lease may find no slot - close it or check the platform log."
  exit 1
else
  fail "no lease got a slot whose round could start (reason above) - attacks would"
  echo "     leave and hit nothing, and the acceptance run would report TP 0 as if"
  echo "     the defence had failed."
  exit 1
fi

if [ "$(cat "$RULES_SAID")" = ok ]; then
  ok "suricata can read its config"
else
  cat "$RULES_SAID"
  echo
  fail "suricata could not check deploy/suricata/rules/local.rules on lease $opened's sensors (reason above)"
fi
rm -f "$RULES_SAID"

section "acceptance (live stack)"
if "$PY" bin/acceptance ${only:+--only "$only"}; then
  ok "test/"
else
  fail "test/"
fi

section "housekeeping"
if pruned="$(./bin/prune --ids "$CR_ACCEPTANCE_LEASES" --apply 2>&1)"; then
  ok "$(printf '%s\n' "$pruned" | head -1) - only leases this run made"
else
  printf '     could not prune the leases this run made; their ids are in %s\n' "$CR_ACCEPTANCE_LEASES"
fi
}

if [ "$CHANGED" = 0 ]; then
  live_acceptance ""
  section "unit + API tests (beside the acceptance suite)"
  wait "$UNIT_PID"
  cat "$UNIT_LOG"
  if [ "$(cat "$UNIT_LOG.code")" = 0 ]; then
    ok "platform/tests"
  else
    fail "platform/tests"
  fi
  rm -f "$UNIT_LOG" "$UNIT_LOG.code"
elif [ "$acceptance_kind" != none ] && [ "$LIVE" = 1 ]; then
  live_acceptance "$acceptance_modules"
elif [ "$acceptance_kind" != none ]; then
  section "acceptance (not run)"
  echo "the change reaches the range; the acceptance tests it needs are listed above."
  echo "run them with: bin/verify --changed${BASE:+ $BASE} --live"
fi

section "result"
if [ "$FAILED" = 0 ] && [ "$CHANGED" = 1 ]; then
  printf '\033[32mthe tests the change reaches are green\033[0m — bin/verify --fast before a commit that touches shared code\n'
elif [ "$FAILED" = 0 ]; then
  printf '\033[32mall green\033[0m — safe to commit\n'
else
  printf '\033[31msomething failed\033[0m — do not commit\n'
fi
exit "$FAILED"
