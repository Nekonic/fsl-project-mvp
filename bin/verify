#!/usr/bin/env bash
# The gate. Nothing gets committed unless this exits 0.
#
#   bin/verify --fast   unit + API tests only (~1s, no Docker)
#   bin/verify          the above + acceptance against the live stack + ratchet
#
# The ratchet is the point: a change that makes the hypothesis bigger is not an
# improvement, however good it looks. The product shell around it is allowed to
# grow and is only reported. See metrics.json and docs/STATE.md.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PY="$ROOT/.venv/bin/python"
FAST=0
FAILED=0

[ "${1:-}" = "--fast" ] && FAST=1

section() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail()    { printf '\033[31mFAIL\033[0m %s\n' "$1"; FAILED=1; }
ok()      { printf '\033[32mok\033[0m   %s\n' "$1"; }

if [ ! -x "$PY" ]; then
  echo "No virtualenv at .venv — run:"
  echo "  python3 -m venv .venv && .venv/bin/pip install -r platform/requirements.txt"
  exit 1
fi

section "unit + API tests"
if (cd platform && "$PY" -m pytest tests -q -p no:cacheprovider); then
  ok "platform/tests"
else
  fail "platform/tests"
fi

if [ "$FAST" = 1 ]; then
  section "metrics (not gated in --fast)"
  ./bin/measure
  [ "$FAILED" = 0 ] && printf '\n\033[32mfast check passed\033[0m — run bin/verify before committing\n'
  exit "$FAILED"
fi

section "stack"
if curl -fsS -o /dev/null --max-time 5 http://localhost:8000/api/rules/; then
  ok "platform responding"
else
  fail "platform not responding — docker compose up -d --build"
  echo
  echo "Skipping acceptance tests: the stack must be up."
  exit 1
fi

if docker image inspect fsl-redteam-tools >/dev/null 2>&1; then
  ok "redteam tool image present"
else
  fail "fsl-redteam-tools missing — docker compose --profile tools build"
fi

# A git checkout or reset while the stack runs replaces the single files that
# are bind-mounted into waf and suricata. The containers keep the old inode and
# their config silently vanishes. Catch it here: otherwise it surfaces as an
# acceptance failure and reads as a defence failure.
if "$PY" - <<'RULECHECK'
import json, pathlib, sys, urllib.request

body = json.dumps(
    {"content": pathlib.Path("deploy/suricata/rules/local.rules").read_text()}
).encode()
request = urllib.request.Request(
    "http://localhost:8000/api/rules/validate/", body,
    {"Content-Type": "application/json"},
)
try:
    sys.exit(0 if json.load(urllib.request.urlopen(request, timeout=30))["ok"] else 1)
except Exception:
    sys.exit(1)
RULECHECK
then
  ok "suricata can read its config"
else
  fail "suricata cannot read its config — its bind-mounted files were replaced"
  echo "     docker compose up -d --force-recreate waf suricata"
fi

section "acceptance (live stack)"
if "$PY" -m pytest test/ -q -p no:cacheprovider; then
  ok "test/"
else
  fail "test/"
fi

section "ratchet"
# bin/measure counts `git ls-files`, so a file that is not added yet is not
# counted. That reads as a change that grew nothing, which is a false green in
# exactly the direction nobody checks. Refuse to measure a dirty tree.
untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  fail "untracked files - metrics would not count them:"
  echo "$untracked" | sed 's/^/       /'
  echo "     git add them, then run bin/verify again"
else
  ok "nothing untracked"
fi

./bin/measure
if "$PY" - <<'PY'
import json, subprocess, sys, pathlib
root = pathlib.Path(".")
baseline_path = root / "metrics.json"
current = json.loads(
    subprocess.run(["./bin/measure", "--json"], capture_output=True, text=True).stdout
)
if not baseline_path.exists():
    print("\nno metrics.json yet — run: bin/measure --save")
    sys.exit(0)
baseline = json.loads(baseline_path.read_text())

# product_loc is measured and printed, never gated: a shell that grows is what
# building a product looks like. core_loc is the hypothesis and may only fall.
GATED = ("core_loc", "dependencies", "services")
# And the test count may only rise. Deleting a test is the cheapest way to make
# any change here pass, and nothing else in this run would notice.
FLOOR = ("tests",)

failed = False

worse = {
    k: (baseline[k], v)
    for k, v in current.items()
    if k in GATED and v > baseline.get(k, v)
}
if worse:
    print("\nthis change grows a gated number:")
    for name, (was, now) in worse.items():
        print(f"  {name}: {was} -> {now}")
    print("\nThat is not an improvement. Either shrink it back, or if the growth")
    print("is genuinely necessary, edit metrics.json by hand and write down why")
    print("in docs/DECISIONS.md.")
    failed = True

shrunk = {
    k: (baseline[k], v)
    for k, v in current.items()
    if k in FLOOR and v < baseline.get(k, v)
}
if shrunk:
    print("\nthe test suite got smaller:")
    for name, (was, now) in shrunk.items():
        print(f"  {name}: {was} -> {now}")
    print("\nA deleted test is cheaper than the change it was hiding, and it")
    print("leaves every other number in this run looking fine. If a test was")
    print("genuinely wrong, say so in docs/DECISIONS.md and lower the floor in")
    print("metrics.json by hand.")
    failed = True

# The escape hatch is allowed. Taking it silently is not: a run that moves a
# gated baseline and touches no line of DECISIONS.md has written the reason
# down nowhere, and an unattended loop would do exactly that.
head = subprocess.run(
    ["git", "show", "HEAD:metrics.json"], capture_output=True, text=True
)
if head.returncode == 0:
    before = json.loads(head.stdout)
    moved = {
        k: (before[k], baseline[k])
        for k in (*GATED, *FLOOR)
        if k in before
        and (baseline.get(k, 0) > before[k] if k in GATED else baseline.get(k, 0) < before[k])
    }
    if moved:
        touched = subprocess.run(
            ["git", "diff", "HEAD", "--name-only"], capture_output=True, text=True
        ).stdout.split()
        if "docs/DECISIONS.md" not in touched:
            print("\nmetrics.json was raised by hand:")
            for name, (was, now) in moved.items():
                print(f"  {name}: {was} -> {now}")
            print("\nThat is the last resort, and it has to be argued for. This")
            print("change touches no line of docs/DECISIONS.md, so the reason is")
            print("written down nowhere. Write it, then run again.")
            failed = True

better = {
    k: (baseline[k], v)
    for k, v in current.items()
    if k not in FLOOR and v < baseline.get(k, v)
}
if better and not failed:
    print("\nsmaller:")
    for name, (was, now) in better.items():
        print(f"  {name}: {was} -> {now}")
    print("\nRecord it: bin/measure --save")

sys.exit(1 if failed else 0)
PY
then
  ok "no regression"
else
  fail "metrics regressed"
fi

section "result"
if [ "$FAILED" = 0 ]; then
  printf '\033[32mall green\033[0m — safe to commit\n'
else
  printf '\033[31msomething failed\033[0m — do not commit\n'
fi
exit "$FAILED"
