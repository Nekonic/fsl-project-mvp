#!/usr/bin/env bash

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PY="$ROOT/.venv/bin/python"
FAST=0
CHANGED=0
LIVE=0
BASE=""
PLATFORM="${FSL_PLATFORM_URL:-http://localhost:8000}"
export FSL_PLATFORM_URL="$PLATFORM"
FAILED=0

case "${1:-}" in
  --fast) FAST=1 ;;
  --changed)
    CHANGED=1
    shift
    for argument in "$@"; do
      case "$argument" in
        --live) LIVE=1 ;;
        *) BASE="$argument" ;;
      esac
    done
    ;;
esac

section() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail()    { printf '\033[31mFAIL\033[0m %s\n' "$1"; FAILED=1; }
ok()      { printf '\033[32mok\033[0m   %s\n' "$1"; }
stack_down() {
  fail "$1"
  echo
  echo "Skipping acceptance tests: the stack must be up."
  exit 1
}

if [ ! -x "$PY" ]; then
  echo "No virtualenv at .venv — run:"
  echo "  python3 -m venv .venv && .venv/bin/pip install -r platform/requirements.txt"
  exit 1
fi

if [ "$CHANGED" = 1 ]; then
  section "selection"
  PLAN="$(mktemp)"
  if ! "$PY" bin/select-tests ${BASE:+"$BASE"} --plan "$PLAN"; then
    fail "bin/select-tests crashed - run bin/verify --fast instead"
    exit 1
  fi
  unit_kind="$(sed -n 's/^unit //p' "$PLAN")"
  unit_files="$(sed -n 's/^unit-file //p' "$PLAN")"
  acceptance_kind="$(sed -n 's/^acceptance //p' "$PLAN")"
  acceptance_modules="$(sed -n 's/^acceptance-module //p' "$PLAN" | paste -sd, -)"
fi

section "unit + API tests"
if [ "$CHANGED" = 1 ] && [ "$unit_kind" = none ]; then
  ok "no unit test reaches the change"
elif [ "$CHANGED" = 1 ] && [ "$unit_kind" = some ]; then
  if (cd platform && "$PY" -m pytest $unit_files -q -p no:cacheprovider); then
    ok "platform/tests, the files the change reaches"
  else
    fail "platform/tests, the files the change reaches"
  fi
elif (cd platform && "$PY" -m pytest tests -q -p no:cacheprovider); then
  ok "platform/tests"
else
  fail "platform/tests"
fi

if [ "$FAST" = 1 ]; then
  section "metrics (not gated in --fast)"
  ./bin/measure || fail "measure crashed - the full run will fail on it too"
  [ "$FAILED" = 0 ] && printf '\n\033[32mfast check passed\033[0m — run bin/verify before committing\n'
  exit "$FAILED"
fi

live_acceptance() {
only="$1"
section "stack"
owner="$(docker inspect fsl-platform --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null)"
if [ -z "$owner" ]; then
  stack_down 'fsl-platform is not there — docker compose up -d --build'
fi
if [ "$(cd "$owner" 2>/dev/null && pwd -P)" != "$(pwd -P)" ]; then
  fail "the stack was brought up from $owner, not from $ROOT"
  echo "     restarting it would run that tree's code and call it this one's."
  echo "     Run bin/verify there, or, if nobody is using that stack,"
  echo '     docker compose up -d --build from here.'
  exit 1
fi
open_sessions="$("$PY" - <<'OPENCHECK' 2>/dev/null
import json, os, sys, urllib.request
try:
    with urllib.request.urlopen(
        os.environ["FSL_PLATFORM_URL"] + "/api/sessions/?state=open", timeout=5
    ) as answer:
        rows = json.load(answer)
except Exception:
    sys.exit(0)
print(" ".join(str(row.get("id")) for row in rows if isinstance(row, dict)))
OPENCHECK
)"
if [ -n "$open_sessions" ]; then
  fail "a session is open (ids: $open_sessions)"
  echo "     bin/verify restarts the platform and prunes sessions, which would"
  echo "     disrupt an open one. Close it first, or wait for it to finish."
  exit 1
fi
if ! docker compose restart platform >/dev/null 2>&1; then
  stack_down 'platform could not be restarted — docker compose up -d --build'
fi
for _ in $(seq 60); do
  curl -fs -o /dev/null --max-time 5 "$PLATFORM/api/sessions/?state=open" && break
  sleep 1
done
if curl -fsS -o /dev/null --max-time 5 "$PLATFORM/api/sessions/?state=open"; then
  ok "platform restarted on the tree being verified"
else
  stack_down "platform not responding after a restart — docker compose logs platform"
fi

FSL_ACCEPTANCE_SESSIONS="$(mktemp)"
export FSL_ACCEPTANCE_SESSIONS

opened="$("$PY" - <<'OPENSTACK'
import json, os, sys, urllib.error, urllib.request

def post(path, body):
    request = urllib.request.Request(
        os.environ["FSL_PLATFORM_URL"] + path, json.dumps(body).encode(),
        {"Content-Type": "application/json"},
    )
    return json.load(urllib.request.urlopen(request, timeout=900))

def refused(error):
    if isinstance(error, urllib.error.HTTPError):
        return json.load(error).get("detail") or error
    return error

try:
    session = post("/api/sessions/", {})
except OSError as error:
    print(refused(error), file=sys.stderr)
    sys.exit(1)
with open(os.environ["FSL_ACCEPTANCE_SESSIONS"], "a") as ids:
    ids.write(f"{session['id']}\n")
print(session["id"])
try:
    post(f"/api/sessions/{session['id']}/close/", {})
except OSError as error:
    print(refused(error), file=sys.stderr)
    sys.exit(2)
OPENSTACK
)"
warmed=$?
if [ "$warmed" -eq 0 ]; then
  ok "session $opened opened its stack and the target is healthy"
elif [ "$warmed" -eq 2 ]; then
  fail "session $opened opened its stack but did not close (reason above);"
  echo "     the next session would get 409 - close it or check the platform log."
  exit 1
else
  fail "no session stack came up (reason above) - attacks would leave and hit"
  echo "     nothing, and the acceptance run would report TP 0 as if the"
  echo "     defence had failed."
  exit 1
fi

kali_image="$(docker compose -f session.yaml config --images kali 2>/dev/null)"
if [ -n "$kali_image" ] && docker image inspect "$kali_image" >/dev/null 2>&1; then
  ok "attacker image present"
else
  fail "${kali_image:-the kali image} missing — docker compose -f session.yaml pull kali"
fi

if "$PY" - <<'RULECHECK'
import json, os, pathlib, sys, time, urllib.request

def resetting():
    try:
        with urllib.request.urlopen(os.environ["FSL_PLATFORM_URL"] + "/api/range/ready/", timeout=30) as answer:
            readiness = json.load(answer)
    except (OSError, ValueError):
        return False
    slots = readiness.get("slots") or [readiness.get("slot") or {}]
    return any(slot.get("phase") in ("RESETTING", "REBUILDING")
               or (slot.get("reset") or {}).get("state") == "running" for slot in slots)

deadline = time.monotonic() + 1800
while resetting() and time.monotonic() < deadline:
    time.sleep(2)

body = json.dumps(
    {"content": pathlib.Path("deploy/suricata/rules/local.rules").read_text()}
).encode()
request = urllib.request.Request(
    os.environ["FSL_PLATFORM_URL"] + "/api/rules/validate/", body,
    {"Content-Type": "application/json"},
)
try:
    sys.exit(0 if json.load(urllib.request.urlopen(request, timeout=30))["ok"] else 1)
except urllib.error.HTTPError as refused:
    said = json.load(refused)
    print(said.get("output") or said.get("detail") or refused, file=sys.stderr)
    sys.exit(1)
except OSError as error:
    print(error, file=sys.stderr)
    sys.exit(1)
RULECHECK
then
  ok "suricata can read its config"
else
  fail "suricata could not validate deploy/suricata/rules/local.rules (reason above)"
  echo "     if it names a file it cannot open, the bind mounts went stale:"
  echo "     open a new session, or: docker compose -p fsl-<id> -f session.yaml"
  echo "     up -d --force-recreate waf suricata"
fi

section "acceptance (live stack)"
if "$PY" bin/acceptance ${only:+--only "$only"}; then
  ok "test/"
else
  fail "test/"
fi

section "housekeeping"
if pruned="$(./bin/prune --ids "$FSL_ACCEPTANCE_SESSIONS" --apply 2>&1)"; then
  ok "$(printf '%s\n' "$pruned" | head -1) - only sessions this run made"
else
  printf '     could not prune the sessions this run made; their ids are in %s\n' "$FSL_ACCEPTANCE_SESSIONS"
fi
}

if [ "$CHANGED" = 0 ]; then
  live_acceptance ""
elif [ "$acceptance_kind" != none ] && [ "$LIVE" = 1 ]; then
  live_acceptance "$acceptance_modules"
elif [ "$acceptance_kind" != none ]; then
  section "acceptance (not run)"
  echo "the change reaches the range; the acceptance tests it needs are listed above."
  echo "run them with: bin/verify --changed${BASE:+ $BASE} --live"
fi

section "ratchet"
untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  fail "untracked files - metrics would not count them:"
  echo "$untracked" | sed 's/^/       /'
  echo "     git add them, then run bin/verify again"
else
  ok "nothing untracked"
fi

./bin/measure
if "$PY" - <<'PY'
import json, subprocess, sys, pathlib
baseline_path = pathlib.Path("metrics.json")
measured = subprocess.run(["./bin/measure", "--json"], capture_output=True, text=True)
if measured.returncode:
    said = measured.stderr.strip().splitlines() or [f"exit {measured.returncode}"]
    print(f"\nmeasure crashed, so nothing was compared:\n  {said[-1]}")
    sys.exit(3)
current = json.loads(measured.stdout)
if not baseline_path.exists():
    print("\nno metrics.json yet — run: bin/measure --save")
    sys.exit(0)
baseline = json.loads(baseline_path.read_text())

GATED = ("core_loc", "dependencies", "services")

moved = {k: (baseline[k], v) for k, v in current.items() if v != baseline.get(k, v)}
worse = {k: m for k, m in moved.items() if k in GATED and m[1] > m[0]}
smaller = {k: m for k, m in moved.items() if m[1] < m[0]}

def show(heading, found, *advice):
    print(heading)
    for name, (was, now) in found.items():
        print(f"  {name}: {was} -> {now}")
    print(*advice, sep="\n")

if worse:
    show("\nthis change grows a gated number:", worse,
         "\nThat is not an improvement. Either shrink it back, or if the growth",
         "is genuinely necessary, edit metrics.json by hand.")
if smaller and not worse:
    show("\nsmaller:", smaller, "\nRecord it: bin/measure --save")

sys.exit(1 if worse else 0)
PY
then
  ok "no regression"
elif [ $? = 3 ]; then
  fail "measure crashed"
else
  fail "metrics regressed"
fi

section "result"
if [ "$FAILED" = 0 ] && [ "$CHANGED" = 1 ]; then
  printf '\033[32mthe tests the change reaches are green\033[0m — bin/verify --fast before a commit that touches shared code\n'
elif [ "$FAILED" = 0 ]; then
  printf '\033[32mall green\033[0m — safe to commit\n'
else
  printf '\033[31msomething failed\033[0m — do not commit\n'
fi
exit "$FAILED"
