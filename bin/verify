#!/usr/bin/env bash

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PY="$ROOT/.venv/bin/python"
FAST=0
FAILED=0

[ "${1:-}" = "--fast" ] && FAST=1

section() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail()    { printf '\033[31mFAIL\033[0m %s\n' "$1"; FAILED=1; }
ok()      { printf '\033[32mok\033[0m   %s\n' "$1"; }
stack_down() {
  fail "$1"
  echo
  echo "Skipping acceptance tests: the stack must be up."
  exit 1
}

if [ ! -x "$PY" ]; then
  echo "No virtualenv at .venv — run:"
  echo "  python3 -m venv .venv && .venv/bin/pip install -r platform/requirements.txt"
  exit 1
fi

section "unit + API tests"
if (cd platform && "$PY" -m pytest tests -q -p no:cacheprovider); then
  ok "platform/tests"
else
  fail "platform/tests"
fi

if [ "$FAST" = 1 ]; then
  section "metrics (not gated in --fast)"
  ./bin/measure || fail "measure crashed - the full run will fail on it too"
  [ "$FAILED" = 0 ] && printf '\n\033[32mfast check passed\033[0m — run bin/verify before committing\n'
  exit "$FAILED"
fi

section "stack"
owner="$(docker inspect fsl-platform --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null)"
if [ -z "$owner" ]; then
  stack_down 'fsl-platform is not there — DOCKER_GID=$(bin/docker-gid) docker compose up -d --build'
fi
if [ "$(cd "$owner" 2>/dev/null && pwd -P)" != "$(pwd -P)" ]; then
  fail "the stack was brought up from $owner, not from $ROOT"
  echo "     restarting it would run that tree's code and call it this one's."
  echo "     Run bin/verify there, or, if nobody is using that stack,"
  echo '     DOCKER_GID=$(bin/docker-gid) docker compose up -d --build from here.'
  exit 1
fi
if ! docker compose restart platform >/dev/null 2>&1; then
  stack_down 'platform could not be restarted — DOCKER_GID=$(bin/docker-gid) docker compose up -d --build'
fi
for _ in $(seq 60); do
  curl -fsS -o /dev/null --max-time 5 http://localhost:8000/api/rules/ && break
  sleep 1
done
if curl -fsS -o /dev/null --max-time 5 http://localhost:8000/api/rules/; then
  ok "platform restarted on the tree being verified"
else
  stack_down "platform not responding after a restart — docker compose logs platform"
fi

if "$PY" - <<'TARGETCHECK'
import json, subprocess, sys, time

DEADLINE = time.time() + 120
while time.time() < DEADLINE:
    done = subprocess.run(
        ["docker", "inspect", "fsl-juice-shop", "--format", "{{json .State.Health}}"],
        capture_output=True, text=True,
    )
    if done.returncode != 0:
        print("fsl-juice-shop is not there", file=sys.stderr)
        sys.exit(1)
    health = json.loads(done.stdout or "null") or {}
    if health.get("Status") == "healthy":
        sys.exit(0)
    time.sleep(3)

print(f"still {health.get('Status')!r} after two minutes", file=sys.stderr)
sys.exit(1)
TARGETCHECK
then
  ok "target healthy"
else
  fail "the target is not healthy — attacks would leave and hit nothing, and"
  echo "     the acceptance run would report TP 0 as if the defence had failed."
  exit 1
fi

if docker image inspect fsl-kali >/dev/null 2>&1; then
  ok "attacker image present"
else
  fail "fsl-kali missing — docker compose build kali"
fi

if "$PY" - <<'RULECHECK'
import json, pathlib, sys, urllib.request

body = json.dumps(
    {"content": pathlib.Path("deploy/suricata/rules/local.rules").read_text()}
).encode()
request = urllib.request.Request(
    "http://localhost:8000/api/rules/validate/", body,
    {"Content-Type": "application/json"},
)
try:
    sys.exit(0 if json.load(urllib.request.urlopen(request, timeout=30))["ok"] else 1)
except urllib.error.HTTPError as refused:
    said = json.load(refused)
    print(said.get("output") or said.get("detail") or refused, file=sys.stderr)
    sys.exit(1)
except OSError as error:
    print(error, file=sys.stderr)
    sys.exit(1)
RULECHECK
then
  ok "suricata can read its config"
else
  fail "suricata could not validate deploy/suricata/rules/local.rules (reason above)"
  echo "     if it names a file it cannot open, the bind mounts went stale:"
  echo "     docker compose up -d --force-recreate waf suricata"
fi

FSL_ACCEPTANCE_SESSIONS="$(mktemp)"
export FSL_ACCEPTANCE_SESSIONS

section "acceptance (live stack)"
if "$PY" -m pytest test/ -q -p no:cacheprovider; then
  ok "test/"
else
  fail "test/"
fi

section "housekeeping"
if pruned="$(./bin/prune --ids "$FSL_ACCEPTANCE_SESSIONS" --apply 2>&1)"; then
  ok "$(printf '%s\n' "$pruned" | head -1) - only sessions this run made"
else
  printf '     could not prune the sessions this run made; their ids are in %s\n' "$FSL_ACCEPTANCE_SESSIONS"
fi

section "ratchet"
untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  fail "untracked files - metrics would not count them:"
  echo "$untracked" | sed 's/^/       /'
  echo "     git add them, then run bin/verify again"
else
  ok "nothing untracked"
fi

./bin/measure
if "$PY" - <<'PY'
import json, subprocess, sys, pathlib
baseline_path = pathlib.Path("metrics.json")
measured = subprocess.run(["./bin/measure", "--json"], capture_output=True, text=True)
if measured.returncode:
    said = measured.stderr.strip().splitlines() or [f"exit {measured.returncode}"]
    print(f"\nmeasure crashed, so nothing was compared:\n  {said[-1]}")
    sys.exit(3)
current = json.loads(measured.stdout)
if not baseline_path.exists():
    print("\nno metrics.json yet — run: bin/measure --save")
    sys.exit(0)
baseline = json.loads(baseline_path.read_text())

GATED = ("core_loc", "dependencies", "services")
FLOOR = ("tests",)

moved = {k: (baseline[k], v) for k, v in current.items() if v != baseline.get(k, v)}
worse = {k: m for k, m in moved.items() if k in GATED and m[1] > m[0]}
shrunk = {k: m for k, m in moved.items() if k in FLOOR and m[1] < m[0]}
better = {k: m for k, m in moved.items() if k not in FLOOR and m[1] < m[0]}

def show(heading, found, *advice):
    print(heading)
    for name, (was, now) in found.items():
        print(f"  {name}: {was} -> {now}")
    print(*advice, sep="\n")

if worse:
    show("\nthis change grows a gated number:", worse,
         "\nThat is not an improvement. Either shrink it back, or if the growth",
         "is genuinely necessary, edit metrics.json by hand.")
if shrunk:
    show("\nthe test suite got smaller:", shrunk,
         "\nA deleted test is cheaper than the change it was hiding, and it",
         "leaves every other number in this run looking fine. If a test was",
         "genuinely wrong, lower the floor in metrics.json by hand.")
if better and not (worse or shrunk):
    show("\nsmaller:", better, "\nRecord it: bin/measure --save")

sys.exit(1 if worse or shrunk else 0)
PY
then
  ok "no regression"
elif [ $? = 3 ]; then
  fail "measure crashed"
else
  fail "metrics regressed"
fi

section "result"
if [ "$FAILED" = 0 ]; then
  printf '\033[32mall green\033[0m — safe to commit\n'
else
  printf '\033[31msomething failed\033[0m — do not commit\n'
fi
exit "$FAILED"
