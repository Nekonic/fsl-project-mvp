#!/usr/bin/env python3

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLATFORM = ROOT / "platform"
PYTHON = ROOT / ".venv" / "bin" / "python"
DROPPED = ("groups", "user_permissions")


def manage(store: Path, *arguments: str) -> str:
    done = subprocess.run(
        [str(PYTHON if PYTHON.exists() else sys.executable), "manage.py", *arguments],
        cwd=PLATFORM, capture_output=True, text=True,
        env={**os.environ, "DJANGO_DB_PATH": str(store), "DJANGO_SETTINGS_MODULE": "cr.settings"},
    )
    if done.returncode != 0:
        raise SystemExit(f"manage.py {' '.join(arguments)} failed on {store}:\n{done.stderr[-2000:]}")
    return done.stdout


def users_in(store: Path) -> list[dict]:
    return json.loads(manage(store, "dumpdata", "auth.User") or "[]")


def carried(rows: list[dict]) -> list[dict]:
    return [{**row, "fields": {key: value for key, value in row["fields"].items() if key not in DROPPED}}
            for row in rows]


def copied(old: Path, copy: Path) -> None:
    source = sqlite3.connect(old.as_uri() + "?mode=ro", uri=True)
    target = sqlite3.connect(copy)
    try:
        source.backup(target)
    finally:
        source.close()
        target.close()


def carry(old: Path, new: Path) -> list[dict]:
    if not old.is_file():
        raise SystemExit(f"no old store at {old}")
    with tempfile.TemporaryDirectory() as scratch:
        copy = Path(scratch) / "old.sqlite3"
        copied(old, copy)
        rows = carried(users_in(copy))
        manage(new, "migrate", "--noinput")
        if users_in(new):
            raise SystemExit(f"{new} already holds users; carry them into a fresh store")
        dump = Path(scratch) / "users.json"
        dump.write_text(json.dumps(rows))
        manage(new, "loaddata", str(dump))
    return rows


def main() -> None:
    parser = argparse.ArgumentParser(description="Carry auth users from the old store into a new one.")
    parser.add_argument("--from", dest="old", type=Path, required=True, help="the old store (read from a copy)")
    parser.add_argument("--into", dest="new", type=Path, required=True, help="the new store, migrated first")
    given = parser.parse_args()
    rows = carry(given.old.resolve(), given.new.resolve())
    staff = sum(row["fields"]["is_staff"] for row in rows)
    pending = sum(not row["fields"]["is_active"] for row in rows)
    print(f"carried {len(rows)} users ({staff} staff, {pending} waiting for approval) into {given.new}")


if __name__ == "__main__":
    main()
