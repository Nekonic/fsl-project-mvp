#!/usr/bin/env python3

from __future__ import annotations

import argparse
import ast
import fnmatch
import os
import re
import subprocess
import sys
from collections import deque
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parent.parent

UNIT_TESTS = "platform/tests/"
ACCEPTANCE_TESTS = "test/"
TEST_FILE = "test_*.py"

DOCS_PREFIXES = ("docs/", ".claude/")
DOCS_SUFFIXES = (".md",)
DOCS_EXACT = ("metrics.json",)

WHOLE_UNIT_SUITE = (
    "platform/pytest.ini",
    "platform/requirements.txt",
    "platform/tests/__init__.py",
    "platform/tests/conftest.py",
    "platform/fsl/settings.py",
)
RANGE_FACING = (
    "wargames/", "redteam/", "deploy/", "platform/", "test/",
    "compose.yaml", "session.yaml", "bin/acceptance",
)
NOT_RANGE_FACING = ("platform/tests/", "platform/console/", "test/durations.json")
ACCEPTANCE_CONFTEST = "test/conftest.py"
URLCONF = "platform/fsl/urls.py"
DJANGO_CLIENT = {"client", "Client"}
GLOB_CALLS = {"glob", "rglob", "iglob"}
RUNS = {"imports", "loads", "calls the API", "is collected with"}
NOT_A_MODULE = {"py", "yaml", "yml", "html", "json", "txt", "sh", "conf", "md", "css", "js", "com", "org", "net", "io"}

TOKEN = re.compile(r"[A-Za-z0-9_./-]+")
DOTTED = re.compile(r"[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+")
IDENTIFIER = re.compile(r"[A-Za-z_]\w*")


def is_docs(path: str) -> bool:
    return path.startswith(DOCS_PREFIXES) or path.endswith(DOCS_SUFFIXES) or path in DOCS_EXACT


def is_unit_test(path: str) -> bool:
    return path.startswith(UNIT_TESTS) and PurePosixPath(path).match(TEST_FILE)


def is_acceptance_test(path: str) -> bool:
    return path.startswith(ACCEPTANCE_TESTS) and PurePosixPath(path).match(TEST_FILE)


def is_range_facing(path: str) -> bool:
    return path.startswith(RANGE_FACING) and not path.startswith(NOT_RANGE_FACING)


def git(root: Path, *argv: str) -> bytes:
    return subprocess.run(["git", *argv], cwd=root, capture_output=True, check=True).stdout


def default_base(root: Path) -> str:
    for ref in ("dev", "origin/dev"):
        try:
            return git(root, "merge-base", "HEAD", ref).decode().strip()
        except subprocess.CalledProcessError:
            continue
    return "HEAD"


def changed_files(root: Path, base: str) -> dict[str, str]:
    committed_only = ".." in base
    span = base.split("..", 1) if committed_only else [base]
    listed = git(root, "diff", "--name-status", "--no-renames", "-z", *span).split(b"\0")
    entries = [os.fsdecode(entry) for entry in listed if entry]
    changed = {entries[i + 1]: entries[i][0] for i in range(0, len(entries) - 1, 2)}
    if not committed_only:
        untracked = git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0")
        changed.update({os.fsdecode(entry): "A" for entry in untracked if entry})
    return dict(sorted(changed.items()))


def tracked(root: Path) -> list[str]:
    listed = git(root, "ls-files", "-z").split(b"\0")
    untracked = git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0")
    paths = dict.fromkeys(os.fsdecode(entry) for entry in listed + untracked if entry)
    return [path for path in paths if (root / path).is_file() and not (root / path).is_symlink()]


def text_of(root: Path, path: str) -> str | None:
    try:
        raw = (root / path).read_bytes()
    except OSError:
        return None
    if b"\0" in raw:
        return None
    return raw.decode("utf-8", errors="replace")


def is_python(path: str, text: str | None) -> bool:
    if path.endswith(".py"):
        return True
    return text is not None and text.startswith("#!") and "python" in text.split("\n", 1)[0]


def import_roots(path: str) -> list[str]:
    if path.startswith("platform/"):
        return ["platform", ""]
    if path.startswith(ACCEPTANCE_TESTS):
        return ["test", ""]
    return [str(PurePosixPath(path).parent), "", "platform"]


def module_index(paths: list[str]) -> dict[str, dict[str, str]]:
    roots = {root for path in paths for root in import_roots(path)}
    index: dict[str, dict[str, str]] = {root: {} for root in roots}
    for path in paths:
        if not path.endswith(".py"):
            continue
        for root in roots:
            prefix = f"{root}/" if root not in ("", ".") else ""
            if not path.startswith(prefix):
                continue
            parts = path[len(prefix):-3].split("/")
            if parts[-1] == "__init__":
                parts = parts[:-1]
            if parts and all(IDENTIFIER.fullmatch(part) for part in parts):
                index[root][".".join(parts)] = path
    return index


def resolve(name: str, roots: list[str], index: dict[str, dict[str, str]]) -> list[str]:
    parts = name.split(".")
    for root in roots:
        known = index.get(root, {})
        if parts[0] not in known:
            continue
        return [known[".".join(parts[:n])] for n in range(1, len(parts) + 1) if ".".join(parts[:n]) in known]
    return []


def own_package(path: str, roots: list[str]) -> list[str]:
    root = roots[0]
    prefix = f"{root}/" if root not in ("", ".") else ""
    return path[len(prefix):].split("/")[:-1]


@dataclass
class Graph:
    paths: list[str]
    edges: dict[str, dict[str, str]] = field(default_factory=dict)
    code: set[str] = field(default_factory=set)

    def link(self, source: str, target: str, kind: str) -> None:
        if source != target:
            self.edges.setdefault(source, {}).setdefault(target, kind)

    def reach(self, start: str) -> dict[str, list[str]]:
        trail: dict[str, list[str]] = {start: [start]}
        running = {start}
        waiting = deque([start])
        while waiting:
            here = waiting.popleft()
            if here not in running and here in self.code:
                continue
            for target, kind in sorted(self.edges.get(here, {}).items()):
                runs = here in running and kind in RUNS
                if target in trail and (target in running or not runs):
                    continue
                trail[target] = trail[here] + [target]
                if runs:
                    running.add(target)
                waiting.append(target)
        return trail


def path_indexes(paths: list[str]):
    whole = set(paths)
    tails: dict[str, set[str]] = {}
    folders: dict[str, set[str]] = {}
    names: dict[str, set[str]] = {}
    for path in paths:
        parts = path.split("/")
        for start in range(1, len(parts) - 1):
            tails.setdefault("/".join(parts[start:]), set()).add(path)
        for start in range(len(parts) - 1):
            for end in range(start + 1, len(parts)):
                folders.setdefault("/".join(parts[start:end]), set()).add(path)
        basename = parts[-1]
        if "." in basename.lstrip(".") or not path.startswith("bin/"):
            names.setdefault(basename, set()).add(path)
    return whole, tails, folders, names


def named_by(token: str, indexes, folders_too: bool) -> set[str]:
    whole, tails, folders, names = indexes
    token = token.strip("/")
    while token.startswith("./"):
        token = token[2:]
    token = token.rstrip(".")
    if not token:
        return set()
    parts = token.split("/")
    for start in range(len(parts) - 1):
        candidate = "/".join(parts[start:])
        if candidate in whole:
            return {candidate}
        if candidate in tails:
            return set(tails[candidate])
        if folders_too and "/" in candidate and candidate in folders:
            return set(folders[candidate])
    return set(names.get(parts[-1], set()))


def globbed_by(pattern: str, paths: list[str], folder: str = "") -> set[str]:
    found = set()
    marker = f"/{folder}/" if folder else "/"
    for path in paths:
        at = f"/{path}".find(marker)
        if at < 0:
            continue
        rest = f"/{path}"[at + len(marker):]
        if fnmatch.fnmatch(rest, pattern) or fnmatch.fnmatch(rest, f"*/{pattern}"):
            found.add(path)
    return found


def folder_of(expression: ast.expr, known: dict[str, list[str]]) -> list[str]:
    if isinstance(expression, ast.Constant) and isinstance(expression.value, str):
        return [part for part in expression.value.split("/") if part and part != "."]
    if isinstance(expression, ast.Name):
        return known.get(expression.id, [])
    if isinstance(expression, ast.BinOp) and isinstance(expression.op, ast.Div):
        return folder_of(expression.left, known) + folder_of(expression.right, known)
    return []


def module_folders(tree: ast.Module) -> dict[str, list[str]]:
    known: dict[str, list[str]] = {}
    for statement in tree.body:
        if isinstance(statement, ast.Assign) and len(statement.targets) == 1 \
                and isinstance(statement.targets[0], ast.Name):
            known[statement.targets[0].id] = folder_of(statement.value, known)
    return known


def routes(root: Path, index) -> list[tuple[re.Pattern, str]]:
    text = text_of(root, URLCONF)
    if text is None:
        return []
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return []
    roots = import_roots(URLCONF)
    aliases: dict[str, str] = {}
    for node in tree.body:
        if isinstance(node, ast.ImportFrom) and node.module and not node.level:
            for alias in node.names:
                found = resolve(f"{node.module}.{alias.name}", roots, index)
                if found:
                    aliases[alias.asname or alias.name] = found[-1]
    table = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Call) and getattr(node.func, "id", "") == "path" and len(node.args) >= 2 \
                and isinstance(node.args[0], ast.Constant) and isinstance(node.args[1], ast.Attribute) \
                and isinstance(node.args[1].value, ast.Name) and node.args[1].value.id in aliases:
            route = node.args[0].value.rstrip("/")
            pattern = "[^/]+".join(re.escape(part) for part in re.split(r"<[^>]+>", route))
            table.append((re.compile(f"/{pattern}/?"), aliases[node.args[1].value.id]))
    return table


def requested(node: ast.AST) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        said = node.value
    elif isinstance(node, ast.JoinedStr):
        said = "".join(part.value if isinstance(part, ast.Constant) else "0" for part in node.values)
    else:
        return None
    return said.split("?", 1)[0] if said.startswith("/") else None


def python_links(graph: Graph, path: str, text: str, index, paths: list[str], table=()) -> None:
    try:
        tree = ast.parse(text, filename=path)
    except (SyntaxError, ValueError):
        return
    roots = import_roots(path)
    testing = path.startswith((UNIT_TESTS, ACCEPTANCE_TESTS))
    known = module_folders(tree)
    browses = False
    urls: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                for target in resolve(alias.name, roots, index):
                    graph.link(path, target, "imports")
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                base = own_package(path, roots)[: len(own_package(path, roots)) - (node.level - 1)]
                module = ".".join(base + ([node.module] if node.module else []))
            else:
                module = node.module or ""
            for alias in node.names:
                for target in resolve(f"{module}.{alias.name}".strip("."), roots, index):
                    graph.link(path, target, "imports")
        elif isinstance(node, ast.Constant) and isinstance(node.value, str):
            if DOTTED.fullmatch(node.value) and node.value.rsplit(".", 1)[1] not in NOT_A_MODULE:
                for target in resolve(node.value, roots, index):
                    graph.link(path, target, "loads" if testing else "names")
        elif isinstance(node, ast.Call):
            called = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
            if testing and called in GLOB_CALLS and node.args and isinstance(node.args[0], ast.Constant) \
                    and isinstance(node.args[0].value, str):
                folder = folder_of(node.func.value, known) if isinstance(node.func, ast.Attribute) else []
                for target in globbed_by(node.args[0].value, paths, "/".join(folder)):
                    graph.link(path, target, "globs")
        elif isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "pytest_plugins" for target in node.targets
        ) and isinstance(node.value, (ast.List, ast.Tuple)):
            for element in node.value.elts:
                if isinstance(element, ast.Constant) and isinstance(element.value, str):
                    for target in resolve(element.value, roots, index):
                        graph.link(path, target, "loads")
        if path.startswith(UNIT_TESTS) and (
            (isinstance(node, ast.arg) and node.arg in DJANGO_CLIENT)
            or (isinstance(node, ast.Name) and node.id in DJANGO_CLIENT)
        ):
            browses = True
        url = requested(node) if path.startswith(UNIT_TESTS) else None
        if url:
            urls.add(url)
    if browses:
        served = {view for url in urls for pattern, view in table if pattern.fullmatch(url)}
        for view in sorted(served):
            graph.link(path, view, "calls the API")
        graph.link(path, URLCONF, "calls the API" if not served else "names")


def build_graph(root: Path, paths: list[str], gone: list[str] = ()) -> Graph:
    everything = sorted(set(paths) | set(gone))
    graph = Graph(everything)
    index = module_index(everything)
    indexes = path_indexes(everything)
    table = routes(root, index)
    for path in paths:
        if is_docs(path):
            continue
        text = text_of(root, path)
        if text is None:
            continue
        if is_python(path, text):
            graph.code.add(path)
            python_links(graph, path, text, index, everything, table)
        testing = path.startswith((UNIT_TESTS, ACCEPTANCE_TESTS))
        for token in set(TOKEN.findall(text)):
            for target in named_by(token, indexes, testing):
                graph.link(path, target, "names")
        if is_acceptance_test(path):
            graph.link(path, ACCEPTANCE_CONFTEST, "is collected with")
    return graph


def test_count(root: Path, path: str) -> int:
    text = text_of(root, path)
    if text is None:
        return 0
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return 0
    return len({node.name for node in tree.body if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")})


@dataclass
class Selection:
    changed: dict[str, str]
    docs: list[str] = field(default_factory=list)
    unit: dict[str, list[str]] = field(default_factory=dict)
    acceptance: dict[str, list[str]] = field(default_factory=dict)
    unit_whole: list[str] = field(default_factory=list)
    acceptance_whole: list[str] = field(default_factory=list)
    unmapped: list[str] = field(default_factory=list)
    per_file: dict[str, tuple[int, int]] = field(default_factory=dict)
    unit_suite: list[str] = field(default_factory=list)
    acceptance_suite: list[str] = field(default_factory=list)

    @property
    def docs_only(self) -> bool:
        return bool(self.changed) and len(self.docs) == len(self.changed)

    @property
    def unit_kind(self) -> str:
        if self.unit_whole:
            return "full"
        return "some" if self.unit else "none"

    @property
    def acceptance_kind(self) -> str:
        if self.acceptance_whole:
            return "full"
        return "some" if self.acceptance else "none"


def select(root: Path, changed: dict[str, str]) -> Selection:
    paths = tracked(root)
    gone = [path for path, status in changed.items() if status == "D" and path not in paths]
    graph = build_graph(root, paths, gone)
    chosen = Selection(changed)
    chosen.unit_suite = sorted(path for path in paths if is_unit_test(path))
    chosen.acceptance_suite = sorted(path for path in paths if is_acceptance_test(path))
    reaches = {test: graph.reach(test) for test in chosen.unit_suite + chosen.acceptance_suite}
    for path, status in changed.items():
        if is_docs(path):
            chosen.docs.append(path)
            continue
        units = [test for test in chosen.unit_suite if path in reaches[test]]
        accepts = [test for test in chosen.acceptance_suite if path in reaches[test]]
        chosen.per_file[path] = (len(units), len(accepts))
        for test in units:
            chosen.unit.setdefault(test, []).append(explain(reaches[test][path], graph))
        for test in accepts:
            chosen.acceptance.setdefault(test, []).append(explain(reaches[test][path], graph))
        if path in WHOLE_UNIT_SUITE:
            chosen.unit_whole.append(path)
        if is_range_facing(path) and not accepts and status != "D":
            chosen.acceptance_whole.append(path)
        if not units and not accepts and status != "D" and path not in WHOLE_UNIT_SUITE:
            chosen.unmapped.append(path)
            chosen.unit_whole.append(path)
    return chosen


def explain(trail: list[str], graph: Graph) -> str:
    if len(trail) == 1:
        return "is changed"
    kind = graph.edges[trail[0]][trail[1]]
    if len(trail) == 2:
        return f"{kind} {trail[1]}"
    hops = " > ".join(trail[1:]) if len(trail) <= 4 else f"{trail[1]} > ... > {trail[-1]}"
    return f"{kind} {hops}"


def report(chosen: Selection, root: Path, out=sys.stdout) -> None:
    def say(line: str = "") -> None:
        print(line, file=out)

    if not chosen.changed:
        say("nothing changed")
        return
    say("changed file                                         status  unit  acceptance")
    for path, status in chosen.changed.items():
        if path in chosen.docs:
            units, accepts = "docs", ""
        else:
            unit_count, accept_count = chosen.per_file.get(path, (0, 0))
            units = "all" if path in chosen.unit_whole else str(unit_count)
            accepts = "all" if path in chosen.acceptance_whole else str(accept_count)
        say(f"  {path[:50]:<50} {status:^6} {units:>5}  {accepts:>10}")
    if chosen.docs_only:
        say("\ndocs only — no tests")
        return
    for path in chosen.unmapped:
        say(f"\n{path}: no test reaches it, so the whole unit suite runs")
    unit_tests = sum(test_count(root, path) for path in chosen.unit_suite)
    if chosen.unit_kind == "full":
        say(f"\nunit: the whole suite, {len(chosen.unit_suite)} files, {unit_tests} tests "
            f"({', '.join(chosen.unit_whole)})")
    else:
        picked = sum(test_count(root, path) for path in chosen.unit)
        say(f"\nunit: {len(chosen.unit)} of {len(chosen.unit_suite)} files, "
            f"{picked} of {unit_tests} tests")
        for test, reasons in sorted(chosen.unit.items()):
            say(f"  {test.removeprefix(UNIT_TESTS):<40} {reasons[0]}"
                + (f" (+{len(reasons) - 1} more)" if len(reasons) > 1 else ""))
    accept_tests = sum(test_count(root, path) for path in chosen.acceptance_suite)
    if chosen.acceptance_kind == "full":
        say(f"\nacceptance: all {len(chosen.acceptance_suite)} files, {accept_tests} tests — "
            f"range-facing and no acceptance test names it: {', '.join(chosen.acceptance_whole)}")
    elif chosen.acceptance_kind == "some":
        picked = sum(test_count(root, path) for path in chosen.acceptance)
        say(f"\nacceptance: {len(chosen.acceptance)} of {len(chosen.acceptance_suite)} files, "
            f"{picked} of {accept_tests} tests")
        for test, reasons in sorted(chosen.acceptance.items()):
            say(f"  {test.removeprefix(ACCEPTANCE_TESTS):<40} {reasons[0]}"
                + (f" (+{len(reasons) - 1} more)" if len(reasons) > 1 else ""))
    else:
        say("\nacceptance: none — nothing changed reaches the range")


def plan_lines(chosen: Selection) -> list[str]:
    if chosen.docs_only or not chosen.changed:
        return ["unit none", "acceptance none"]
    lines = [f"unit {chosen.unit_kind}"]
    if chosen.unit_kind == "some":
        lines += [f"unit-file {test.removeprefix('platform/')}" for test in sorted(chosen.unit)]
    lines.append(f"acceptance {chosen.acceptance_kind}")
    if chosen.acceptance_kind == "some":
        lines += [f"acceptance-module {PurePosixPath(test).stem}" for test in sorted(chosen.acceptance)]
    return lines


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="pick the tests a change reaches")
    parser.add_argument("base", nargs="?", help="commit to diff against, or A..B; default: merge-base with dev")
    parser.add_argument("--plan", help="write the selection to this file for bin/verify")
    args = parser.parse_args(argv)
    base = args.base or default_base(ROOT)
    try:
        changed = changed_files(ROOT, base)
    except subprocess.CalledProcessError as refused:
        print(f"git could not list the changes since {base}: {refused.stderr.decode().strip()}", file=sys.stderr)
        return 2
    chosen = select(ROOT, changed)
    print(f"changes since {base}")
    report(chosen, ROOT)
    if args.plan:
        Path(args.plan).write_text("\n".join(plan_lines(chosen)) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
