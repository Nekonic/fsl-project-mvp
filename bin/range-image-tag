#!/usr/bin/env python3

import contextlib
import importlib.util
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

REBUILD = Path(__file__).resolve().parent / "platform-rebuild"


def rebuild_module():
    loader = SourceFileLoader("platform_rebuild", str(REBUILD))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("platform_rebuild", loader))
    loader.exec_module(module)
    return module


if __name__ == "__main__":
    with contextlib.redirect_stdout(sys.stderr):
        tag = rebuild_module().range_image_tag()
    print(tag)
