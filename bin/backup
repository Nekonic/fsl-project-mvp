#!/usr/bin/env python3

import argparse
import inspect
import os
import re
import selectors
import shlex
import shutil
import sqlite3
import subprocess
import tempfile
from contextlib import closing, suppress
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BACKUPS = ROOT / "backups"
STORE_EXEC = "docker exec -i cr-postgres bash -s"
PLATFORM_EXEC = "docker exec -i cr-platform python -"
TIMEOUT = 600
CHUNK = 1 << 20
ARCHIVE_MAGIC = b"PGDMP"
STAMP = r"\d{8}T\d{6}(?:Z|[+-]\d{4})"
STAMPED = re.compile(rf"store-({STAMP})\.pgdump")
LEGACY = re.compile(rf"db-({STAMP})\.sqlite3")
UTC9 = timezone(timedelta(hours=9))
ROWS_SAID = "rows "

TABLES = (
    ("users", "auth_user"),
    ("allocations", "training_allocation"),
    ("rounds", "training_round"),
    ("players", "training_player"),
    ("actions", "training_action"),
    ("tool runs", "training_toolrun"),
    ("detections", "telemetry_detection"),
    ("customer requests", "training_customerrequest"),
    ("objectives", "scoring_objective"),
    ("verdicts", "scoring_verdict"),
    ("rule sets", "training_ruleset"),
    ("rule tests", "training_ruletest"),
    ("events", "telemetry_event"),
    ("problems", "training_problem"),
    ("postures", "training_posture"),
)

IN_STORE = '-X -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

COUNTED = (
    "SELECT relname, (xpath('/row/c/text()', query_to_xml(format('SELECT count(*) AS c FROM public.%I', relname), "
    "false, true, '')))[1]::text FROM pg_class WHERE relkind = 'r' AND relnamespace = 'public'::regnamespace"
)

DUMP = f"""{{
set -e
taken=$(mktemp -d)
trap 'rm -rf "$taken"' EXIT
pg_dump -Fc -U "$POSTGRES_USER" -d "$POSTGRES_DB" -f "$taken/store"
pg_restore --list "$taken/store" > /dev/null
psql {IN_STORE} -At -F ' ' -c {shlex.quote(COUNTED)} | sed 's/^/{ROWS_SAID}/' >&2
cat "$taken/store"
}}
"""

RESTORE = f"""{{
set -e
given=$(mktemp -d)
trap 'rm -rf "$given"' EXIT
cat > "$given/store"
pg_restore --no-owner --no-privileges -f "$given/store.sql" "$given/store"
psql {IN_STORE} --single-transaction -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public' -f "$given/store.sql"
psql {IN_STORE} -At -F ' ' -c {shlex.quote(COUNTED)} | sed 's/^/{ROWS_SAID}/' >&2
}}
"""

IMPORTS = """
import os, shutil, sqlite3, sys, tempfile
from pathlib import Path
"""

WRITE_THE_STORE = """
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "cr.settings")
from django.conf import settings
snapshot(settings.DATABASES["default"]["NAME"], sys.stdout.buffer)
"""


def snapshot(path, out):
    source = sqlite3.connect(Path(path).resolve().as_uri() + "?mode=rw", uri=True)
    with tempfile.TemporaryDirectory() as scratch:
        taken = Path(scratch) / "snapshot.sqlite3"
        try:
            source.execute("VACUUM INTO ?", (str(taken),))
        finally:
            source.close()
        with open(taken, "rb") as image:
            shutil.copyfileobj(image, out, 1 << 20)
    out.flush()


def way_in(variable, default):
    chosen = os.environ.get(variable, "").strip() or default
    return chosen, shlex.split(chosen)


def started(command, variable, default):
    try:
        return subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as error:
        raise SystemExit(
            f"backup: cannot run {command[0]!r}: {error.strerror}. {variable} is the command that "
            f"reaches the store (default: {default})"
        )


def fetch(out, program, variable, default):
    chosen, command = way_in(variable, default)
    running = started(command, variable, default)
    with running:
        hand_over(running.stdin, program)
        said = drain(running, out, chosen)
    if running.returncode != 0:
        said = said.decode(errors="replace").strip() or "(nothing on stderr)"
        raise SystemExit(f"backup: no snapshot; {chosen!r} exited {running.returncode}:\n{said}")
    return out.tell(), said


def hand_over(stdin, program, data=None):
    with suppress(BrokenPipeError):
        stdin.write(program)
        if data is not None:
            shutil.copyfileobj(data, stdin, CHUNK)
    with suppress(BrokenPipeError):
        stdin.close()


def drain(running, out, chosen):
    said = bytearray()
    watching = selectors.DefaultSelector()
    watching.register(running.stdout, selectors.EVENT_READ, out)
    watching.register(running.stderr, selectors.EVENT_READ, said)
    while watching.get_map():
        ready = watching.select(TIMEOUT)
        if not ready:
            running.kill()
            raise SystemExit(
                f"backup: nothing from {chosen!r} for {TIMEOUT}s; "
                f"something may be holding the store locked"
            )
        for key, _ in ready:
            chunk = os.read(key.fileobj.fileno(), CHUNK)
            if not chunk:
                watching.unregister(key.fileobj)
            elif key.data is said:
                said += chunk
            else:
                out.write(chunk)
    running.wait()
    return bytes(said)


def counted(said):
    present = {}
    for line in said.decode(errors="replace").splitlines():
        if line.startswith(ROWS_SAID):
            table, _, count = line[len(ROWS_SAID):].partition(" ")
            with suppress(ValueError):
                present[table] = int(count)
    if not set(present) & {table for _, table in TABLES}:
        raise SystemExit("backup: the snapshot is not the platform's store: it holds none of its tables")
    return {table: present.get(table) for _, table in TABLES}


def is_archive(path):
    with open(path, "rb") as image:
        return image.read(len(ARCHIVE_MAGIC)) == ARCHIVE_MAGIC


def check(path):
    try:
        read_only = path.as_uri() + "?mode=ro&immutable=1"
        with closing(sqlite3.connect(read_only, uri=True)) as db:
            verdict = [row[0] for row in db.execute("PRAGMA integrity_check")]
            if verdict != ["ok"]:
                raise SystemExit(
                    "backup: the snapshot fails integrity_check:\n" + "\n".join(verdict)
                )
            present = {
                name for (name,) in db.execute("SELECT name FROM sqlite_master WHERE type = 'table'")
            }
            if not present & {table for _, table in TABLES}:
                raise SystemExit(
                    "backup: the snapshot is not the platform's store: it holds none of its tables"
                )
            return {
                table: db.execute(f"SELECT count(*) FROM {table}").fetchone()[0]
                if table in present else None
                for _, table in TABLES
            }
    except sqlite3.Error as error:
        raise SystemExit(f"backup: the snapshot is not the platform's store: {error}")


def stamp_of(path):
    named = STAMPED.fullmatch(path.name) or LEGACY.fullmatch(path.name)
    return instant(named.group(1)) if named else None


def instant(stamp):
    return datetime.strptime(stamp.removesuffix("Z") + ("+0000" if stamp.endswith("Z") else ""), "%Y%m%dT%H%M%S%z")


def stamp_now(now=None):
    return (now or datetime.now(timezone.utc)).astimezone(UTC9).strftime("%Y%m%dT%H%M%S%z")


def stamped(directory):
    return sorted((path for path in directory.iterdir() if stamp_of(path)), key=stamp_of) if directory.is_dir() else []


def kept_as(name, take):
    BACKUPS.mkdir(parents=True, exist_ok=True)
    partial = BACKUPS / f"{name}.partial"
    try:
        with open(partial, "wb") as out:
            size, rows = take(out, partial)
            out.flush()
            os.fsync(out.fileno())
        rows = rows if rows is not None else check(partial)
        if not any(rows.values()):
            return None, size, rows
        kept = BACKUPS / name
        os.replace(partial, kept)
        return kept, size, rows
    finally:
        partial.unlink(missing_ok=True)


def take_archive(out, partial):
    size, said = fetch(out, DUMP.encode(), "CR_STORE_EXEC", STORE_EXEC)
    out.flush()
    if not is_archive(partial):
        raise SystemExit("backup: the answer is not a pg_dump custom-format archive")
    return size, counted(said)


def take_sqlite(out, partial):
    program = (IMPORTS + inspect.getsource(snapshot) + WRITE_THE_STORE).encode()
    size, _ = fetch(out, program, "CR_PLATFORM_EXEC", PLATFORM_EXEC)
    return size, None


def keep(legacy=False):
    stamp = stamp_now()
    if legacy:
        return kept_as(f"db-{stamp}.sqlite3", take_sqlite)
    return kept_as(f"store-{stamp}.pgdump", take_archive)


def thin(kept, newest):
    older = [path for path in stamped(kept.parent) if path != kept]
    gone = older[:max(0, len(older) - newest + 1)]
    for path in gone:
        path.unlink()
    return gone


def restore(archive):
    if not is_archive(archive):
        raise SystemExit(f"backup: {archive} is not a pg_dump custom-format archive")
    chosen, command = way_in("CR_STORE_EXEC", STORE_EXEC)
    running = started(command, "CR_STORE_EXEC", STORE_EXEC)
    with running, open(archive, "rb") as data:
        hand_over(running.stdin, RESTORE.encode(), data)
        said = drain(running, open(os.devnull, "wb"), chosen)
    if running.returncode != 0:
        said = said.decode(errors="replace").strip() or "(nothing on stderr)"
        raise SystemExit(f"backup: {archive} was not restored; {chosen!r} exited {running.returncode}:\n{said}")
    return counted(said)


def printed_rows(rows):
    for label, table in TABLES:
        count = "absent" if rows[table] is None else rows[table]
        print(f"  {label:<18} {count:>8}")


def main():
    parser = argparse.ArgumentParser(
        description="Dump the platform's PostgreSQL store into backups/store-<UTC+9 stamp>.pgdump (pg_dump "
                    "custom format) while it keeps serving, then remove the older stamped backups beyond "
                    f"--keep. CR_STORE_EXEC chooses how to reach the store (default: {STORE_EXEC}). "
                    "With --restore, load such an archive into the store instead, replacing what it holds.",
    )
    parser.add_argument("--keep", type=int, default=1,
                        help="how many backups to leave in backups/, this one included (default 1)")
    parser.add_argument("--restore", type=Path, metavar="ARCHIVE",
                        help="restore this store-<UTC+9 stamp>.pgdump into the store, in one transaction")
    parser.add_argument("--sqlite", action="store_true",
                        help="back up a platform that still runs the SQLite store, into db-<UTC+9 stamp>.sqlite3 "
                             f"(CR_PLATFORM_EXEC, default: {PLATFORM_EXEC})")
    args = parser.parse_args()
    if args.keep < 1:
        parser.error("--keep must be at least 1: the backup just taken is always kept")

    if args.restore is not None:
        rows = restore(args.restore)
        print(f"restored {args.restore}")
        printed_rows(rows)
        return

    kept, size, rows = keep(args.sqlite)
    if kept is None:
        print("no backup kept: the store holds no rows, so no older backup was removed")
        printed_rows(rows)
        return
    gone = thin(kept, args.keep)
    print(kept)
    print(f"  {size} bytes, " + ("integrity_check ok" if args.sqlite else "pg_restore --list ok"))
    printed_rows(rows)
    for path in gone:
        print(f"  removed {path.name}, older than the newest {args.keep}")


if __name__ == "__main__":
    main()
