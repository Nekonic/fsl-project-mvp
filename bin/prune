#!/usr/bin/env python3

import argparse
import shlex
import subprocess
import sys

CONTAINER = "cr-platform"


def command(ids=None, apply=False):
    argv = ["docker", "exec", CONTAINER, "python", "manage.py", "prune"]
    if ids is not None:
        argv += ["--allocations", *(str(allocation) for allocation in sorted(ids))]
    if not apply:
        argv.append("--dry-run")
    return argv


def run(argv):
    result = subprocess.run(argv, capture_output=True, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr or f"could not run {shlex.join(argv)}\n")
        raise SystemExit(1)
    return result.stdout


def main():
    parser = argparse.ArgumentParser(
        description="Drop closed allocations with their rounds, players, actions, detections and events.",
    )
    parser.add_argument("--ids", metavar="FILE",
                        help="drop only the closed allocations whose ids FILE lists, one per line; open ones are "
                             "never touched. Without it, the closed allocations past CR_RETAIN_CLOSED_MINUTES go")
    parser.add_argument("--apply", action="store_true",
                        help="actually delete; without this nothing is written")
    args = parser.parse_args()

    ids = None
    if args.ids is not None:
        with open(args.ids, encoding="utf-8") as listed:
            ids = {int(line) for line in listed if line.strip()}

    sys.stdout.write(run(command(ids=ids, apply=args.apply)))
    if not args.apply:
        print("dry run - nothing was deleted. Add --apply to do it.")


if __name__ == "__main__":
    main()
