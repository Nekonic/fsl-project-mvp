#!/usr/bin/env python3

from __future__ import annotations

import argparse
import ast
import json
import os
import re
import subprocess
import sys
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parent.parent
BASELINE = ROOT / "metrics.json"

EXCLUDE_PREFIXES = ("docs/", "test/", "platform/tests/", "bin/", ".claude/")
EXCLUDE_SUFFIXES = (".md",)
EXCLUDE_EXACT = (".gitignore", "metrics.json", "platform/pytest.ini")
EXCLUDE_CONTAINS = ("/migrations/",)

CORE = (
    "platform/scoring/",
    "platform/ingest/",
    "platform/rules/",
    "redteam/harness.py",
)

TEST_DIRS = ("platform/tests/", "test/")
TEST_FILES = "test_*.py"

COMPOSE_FILES = ("compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml")
COMPOSE_OVERRIDES = (
    "compose.override.yml",
    "compose.override.yaml",
    "docker-compose.override.yml",
    "docker-compose.override.yaml",
)
YAML_KEY = re.compile(r"""(["']?)([A-Za-z0-9._-]+)\1[ \t]*:(?:[ \t]|$)""")
BLOCK_VALUE = re.compile(r"[ \t]*(?:&[^\s#]+)?[ \t]*(?:#.*)?")

METRICS = ("core_loc", "product_loc", "dependencies", "services", "tests")
GATED = ("core_loc", "dependencies", "services")
FLOOR = ("tests",)

def tracked_files() -> list[str]:
    listed = subprocess.run(
        ["git", "ls-files", "-z"], cwd=ROOT, capture_output=True, check=True
    ).stdout
    paths = dict.fromkeys(os.fsdecode(entry) for entry in listed.split(b"\0") if entry)
    return [
        path for path in paths
        if (ROOT / path).is_file() and not (ROOT / path).is_symlink()
    ]

def is_production(path: str) -> bool:
    if path.startswith(EXCLUDE_PREFIXES):
        return False
    if path.endswith(EXCLUDE_SUFFIXES):
        return False
    if path in EXCLUDE_EXACT:
        return False
    return not any(part in path for part in EXCLUDE_CONTAINS)

def production_loc() -> tuple[int, int, dict[str, int]]:
    per_file: dict[str, int] = {}
    for path in tracked_files():
        if not is_production(path):
            continue
        text = (ROOT / path).read_text(encoding="utf-8", errors="replace")
        count = sum(1 for line in text.splitlines() if line.strip())
        if count:
            per_file[path] = count
    core = sum(n for path, n in per_file.items() if path.startswith(CORE))
    return core, sum(per_file.values()) - core, per_file

def dependencies() -> int:
    requirements = ROOT / "platform" / "requirements.txt"
    if not requirements.exists():
        return 0
    return sum(
        1
        for line in requirements.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    )

def tests() -> int:
    total = 0
    for path in tracked_files():
        if not path.startswith(TEST_DIRS) or not PurePosixPath(path).match(TEST_FILES):
            continue
        module = ast.parse((ROOT / path).read_bytes(), filename=path)
        names = [
            node.name
            for node in module.body
            if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
        ]
        twice = sorted({name for name in names if names.count(name) > 1})
        if twice:
            raise SystemExit(
                f"measure: {path} defines {', '.join(twice)} more than once, "
                f"and pytest runs only the last of each"
            )
        total += len(names)
    return total

def services() -> int:
    for name in COMPOSE_OVERRIDES:
        if (ROOT / name).exists():
            raise SystemExit(
                f"measure: {name} exists, and Compose merges it into the stack; "
                f"move its services into compose.yaml or delete it"
            )
    for name in COMPOSE_FILES:
        if (ROOT / name).exists():
            return len(service_names(ROOT / name))
    return 0

def service_names(compose: Path) -> set[str]:
    def refuse(number: int, what: str) -> None:
        raise SystemExit(
            f"measure: {compose.name} line {number}: {what}; measure counts the "
            f"services written out one per key under a block-style services:"
        )

    lines = [
        (number, line)
        for number, line in enumerate(compose.read_text().splitlines(), 1)
        if line.strip() and not line.strip().startswith("#")
    ]
    if lines and lines[0][1].rstrip() == "---":
        lines = lines[1:]
    names: set[str] = set()
    inside = seen = False
    indent = None
    for number, line in lines:
        depth = len(line) - len(line.lstrip(" "))
        text = line[depth:].rstrip()
        if depth == 0:
            key = YAML_KEY.match(text)
            if not key:
                refuse(number, "not a top-level key")
            if key[2] == "include":
                refuse(number, "include: adds services from other files")
            inside = key[2] == "services"
            if inside and (seen or not BLOCK_VALUE.fullmatch(text[key.end():])):
                refuse(number, "services is not one block mapping")
            seen = seen or inside
            continue
        if not inside:
            continue
        indent = depth if indent is None else indent
        if depth > indent:
            continue
        if text.startswith("<<"):
            refuse(number, "<< merges services in from an anchor")
        key = YAML_KEY.match(text)
        if depth < indent or not key:
            refuse(number, "not a service name")
        names.add(key[2])
    return names

def measure() -> dict[str, int]:
    core, product, _ = production_loc()
    return {
        "core_loc": core,
        "product_loc": product,
        "dependencies": dependencies(),
        "services": services(),
        "tests": tests(),
    }

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--save", action="store_true", help="write metrics.json")
    parser.add_argument("--files", action="store_true", help="per-file breakdown")
    args = parser.parse_args()

    current = measure()

    if args.json:
        print(json.dumps(current, indent=2))
    else:
        baseline = json.loads(BASELINE.read_text()) if BASELINE.exists() else None
        for name in METRICS:
            now = current[name]
            if baseline is None:
                print(f"{name:<16} {now}")
                continue
            was = baseline.get(name, now)
            arrow = "=" if now == was else ("v" if now < was else "^")
            if name in GATED:
                gate = ""
            elif name in FLOOR:
                gate = "   (floor)"
            else:
                gate = "   (not gated)"
            print(f"{name:<16} {now:>6}  {arrow} baseline {was}{gate}")

    if args.files:
        *_, per_file = production_loc()
        print()
        for path, count in sorted(per_file.items(), key=lambda kv: -kv[1]):
            print(f"{count:>6}  {path}")

    if args.save:
        BASELINE.write_text(json.dumps(current, indent=2) + "\n")
        print(f"\nwrote {BASELINE.relative_to(ROOT)}")

    return 0

if __name__ == "__main__":
    sys.exit(main())
