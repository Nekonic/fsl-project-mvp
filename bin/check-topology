#!/usr/bin/env python3

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOPOLOGY = ROOT / "deploy" / "topology"
GENERATED = "generated"
VERSIONS = ("2.2.61", "3.1.0a6")
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "fsl" / "check-topology"

LOAD = """
import json, sys, types
import aiohttp.web
try:
    import magic
except ImportError:
    sys.modules["magic"] = types.ModuleType("magic")
    print("libmagic is not installed here; magic is stubbed, which loading a topology never calls", file=sys.stderr)
from gns3server.version import __version__
from gns3server.controller.topology import load_topology
import gns3server, os
path = sys.argv[1]
before = json.load(open(path))["revision"]
loaded = load_topology(path)
nodes = loaded["topology"]["nodes"]
links = loaded["topology"]["links"]
bundled = os.path.join(os.path.dirname(gns3server.__file__), "symbols")
missing = sorted({n["symbol"] for n in nodes if n["symbol"].startswith(":/symbols/")
                  and not os.path.isfile(os.path.join(bundled, n["symbol"].removeprefix(":/symbols/")))})
if missing:
    sys.exit(f"symbols this release does not bundle: {', '.join(missing)}")
print(f"gns3-server {__version__}: loaded revision {before} as {loaded['revision']}, "
      f"{len(nodes)} nodes, {len(links)} links, names "
      f"{'kept' if [n['name'] for n in nodes] == [n['name'] for n in json.load(open(sys.argv[2]))['topology']['nodes']] else 'CHANGED'}")
"""

def venv(version: str, python: str) -> Path:
    home = CACHE / version
    interpreter = home / "bin" / "python"
    if (home / ".installed").is_file():
        return interpreter
    shutil.rmtree(home, ignore_errors=True)
    subprocess.run([python, "-m", "venv", str(home)], check=True)
    subprocess.run([str(interpreter), "-m", "pip", "install", "--quiet", "--upgrade", "pip"], check=True)
    subprocess.run([str(interpreter), "-m", "pip", "install", "--quiet", f"gns3-server=={version}"], check=True)
    (home / ".installed").write_text(version)
    return interpreter

GENERATE = """
import json, sys
from pathlib import Path
import topology
from range.interfaces import Interface

def fixture_range(document):
    by_id = {node["node_id"]: node for node in document["topology"]["nodes"]}
    found = []
    for index, link in enumerate(document["topology"]["links"]):
        ends = [(by_id[end["node_id"]], end) for end in link["nodes"]]
        for (node, end), (other, _) in (ends, ends[::-1]):
            found.append(Interface(node["name"], f"eth{end['adapter_number']}",
                                   f"10.{index}.{end['adapter_number']}.2/24", other["name"]))
    return found

for source, written in zip(sys.argv[1::2], sys.argv[2::2]):
    document = json.loads(Path(source).read_text())
    Path(written).write_text(json.dumps(topology.labelled(document, fixture_range(document), "slot-1", "slot 1")))
"""

def generated(into: Path) -> list[Path]:
    sources = sorted(TOPOLOGY.glob("*.gns3"))
    made = [into / GENERATED / source.name for source in sources]
    made[0].parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([str(ROOT / ".venv" / "bin" / "python"), "-c", GENERATE,
                    *[str(path) for pair in zip(sources, made) for path in pair]],
                   cwd=ROOT / "platform", check=True, env={**os.environ, "DJANGO_SETTINGS_MODULE": "fsl.settings"})
    return made

def check(interpreter: Path, project: Path) -> bool:
    with tempfile.TemporaryDirectory() as scratch:
        copy = Path(scratch) / project.stem / project.name
        copy.parent.mkdir()
        shutil.copyfile(project, copy)
        done = subprocess.run(
            [str(interpreter), "-I", "-c", LOAD, str(copy), str(project)],
            capture_output=True, text=True, cwd=scratch,
        )
    failed = (done.stderr or "").strip().splitlines()[-1:] or [f"exit {done.returncode}"]
    said = done.stdout.strip() if done.returncode == 0 else failed[0]
    shown = project.relative_to(TOPOLOGY) if project.is_relative_to(TOPOLOGY) else f"{GENERATED}/{project.name}"
    print(f"  {shown}: {'ok' if done.returncode == 0 else 'FAILED'}: {said}")
    return done.returncode == 0

def main() -> int:
    parser = argparse.ArgumentParser(description="load the range's GNS3 projects in real gns3-server releases")
    parser.add_argument("--python", default=os.environ.get("FSL_CHECK_PYTHON", "python3"))
    parser.add_argument("--version", action="append", choices=VERSIONS)
    args = parser.parse_args()
    projects = sorted(TOPOLOGY.glob("*.gns3")) + sorted((TOPOLOGY / "system").glob("*.gns3"))
    if not projects:
        print(f"check-topology: no .gns3 file in {TOPOLOGY}")
        return 1
    passed = True
    scratch = tempfile.TemporaryDirectory()
    projects += generated(Path(scratch.name))
    for version in args.version or VERSIONS:
        try:
            interpreter = venv(version, args.python)
        except subprocess.CalledProcessError as exc:
            print(f"gns3-server {version}: could not install ({exc})")
            passed = False
            continue
        print(f"gns3-server {version} ({CACHE / version})")
        for project in projects:
            passed = check(interpreter, project) and passed
    return 0 if passed else 1

if __name__ == "__main__":
    sys.exit(main())
