#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
GENERATOR="$ROOT/.venv/bin/openapi-python-client"
TYPESCRIPT="openapi-typescript@7.13.0"
SCHEMA="$ROOT/openapi/schema.yaml"
TYPES="$ROOT/front/src/api/schema.d.ts"

(cd "$ROOT/platform" && "$PY" -W ignore manage.py spectacular --file "$SCHEMA" --validate --fail-on-warn)

"$GENERATOR" generate --path "$SCHEMA" --output-path "$ROOT/bots/client" --meta none --overwrite \
  --config "$ROOT/openapi/python-client.yaml" > /dev/null

if command -v npx > /dev/null; then
  mkdir -p "$(dirname "$TYPES")"
  npx --yes "$TYPESCRIPT" "$SCHEMA" --output "$TYPES" > /dev/null
else
  echo "gen-clients: no node here, so front/src/api/schema.d.ts was not generated" >&2
fi
