#!/usr/bin/env python3

from __future__ import annotations

import json
import math
import sys

A1, A2, A3, A4 = 1.340264, -0.081106, 0.000893, 0.003796
M = math.sqrt(3) / 2
SOUTHERNMOST = -60.0
STEPS_PER_UNIT = 10

def equal_earth(lon: float, lat: float) -> tuple[float, float]:
    l = math.asin(M * math.sin(math.radians(lat)))
    l2 = l * l
    l6 = l2 * l2 * l2
    return (
        math.radians(lon) * math.cos(l) / (M * (A1 + 3 * A2 * l2 + l6 * (7 * A3 + 9 * A4 * l2))),
        l * (A1 + A2 * l2 + l6 * (A3 + A4 * l2)),
    )

WIDTH = 360.0
SCALE = WIDTH / 2 / equal_earth(180.0, 0.0)[0]
TOP = equal_earth(0.0, 90.0)[1]

def project(lon: float, lat: float) -> tuple[float, float]:
    x, y = equal_earth(lon, lat)
    return WIDTH / 2 + SCALE * x, SCALE * (TOP - y)

HEIGHT = round(project(0.0, SOUTHERNMOST)[1], 1)

def decode_arcs(topology: dict) -> list[list[tuple[float, float]]]:
    scale = topology["transform"]["scale"]
    translate = topology["transform"]["translate"]
    decoded = []
    for arc in topology["arcs"]:
        x = y = 0
        points = []
        for dx, dy in arc:
            x += dx
            y += dy
            points.append(
                (x * scale[0] + translate[0], y * scale[1] + translate[1])
            )
        decoded.append(points)
    return decoded

def ring_points(arc_indices, arcs):
    points = []
    for index in arc_indices:
        arc = arcs[~index][::-1] if index < 0 else arcs[index]
        points.extend(arc[1:] if points else arc)
    return points

def unwrapped(points):
    shift, previous, out = 0.0, None, []
    for lon, lat in points:
        if previous is not None and abs(lon + shift - previous) > 180:
            shift += 360.0 if lon + shift < previous else -360.0
        previous = lon + shift
        out.append((previous, lat))
    return out

def clipped(points, keep, edge):
    out = []
    for (lon1, lat1), (lon2, lat2) in zip(points[-1:] + points[:-1], points):
        if keep(lon2) != keep(lon1):
            out.append((edge, lat1 + (edge - lon1) * (lat2 - lat1) / (lon2 - lon1)))
        if keep(lon2):
            out.append((lon2, lat2))
    return out

def on_the_sphere(points):
    ring = unwrapped(points)
    for shift in (0.0, -360.0, 360.0):
        piece = [(lon + shift, lat) for lon, lat in ring]
        piece = clipped(piece, lambda lon: lon <= 180.0, 180.0)
        piece = clipped(piece, lambda lon: lon >= -180.0, -180.0) if piece else []
        if len(piece) >= 3:
            yield piece

def number(steps: int) -> str:
    text = f"{steps / STEPS_PER_UNIT:g}"
    return text.replace("0.", ".", 1) if text.startswith(("0.", "-0.")) else text

def joined(numbers: list[str]) -> str:
    out = numbers[0]
    for previous, n in zip(numbers, numbers[1:]):
        glued = n.startswith("-") or (n.startswith(".") and "." in previous)
        out += n if glued else " " + n
    return out

def drawn(points) -> str:
    steps = []
    for lon, lat in points:
        x, y = project(lon, lat)
        step = (round(x * STEPS_PER_UNIT), round(y * STEPS_PER_UNIT))
        if not steps or step != steps[-1]:
            steps.append(step)
    if steps[0] == steps[-1]:
        steps.pop()
    if len(steps) < 3:
        return ""
    moves = [
        number(n)
        for (x0, y0), (x1, y1) in zip(steps, steps[1:])
        for n in (x1 - x0, y1 - y0)
    ]
    return f"M{joined([number(steps[0][0]), number(steps[0][1])])}l{joined(moves)}z"

def path_for(ring, arcs) -> str:
    points = ring_points(ring, arcs)
    if len(points) < 3 or max(lat for _, lat in points) < SOUTHERNMOST:
        return ""
    return "".join(drawn(piece) for piece in on_the_sphere(points))

def main() -> int:
    topology = json.load(open(sys.argv[1]))
    arcs = decode_arcs(topology)

    rings = []
    for geometry in topology["objects"]["land"]["geometries"]:
        polygons = (
            geometry["arcs"]
            if geometry["type"] == "MultiPolygon"
            else [geometry["arcs"]]
        )
        for polygon in polygons:
            for ring in polygon:
                rings.append(path_for(ring, arcs))

    print(f'<path id="land" fill-rule="evenodd" d="{"".join(rings)}"/>')
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
