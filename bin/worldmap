#!/usr/bin/env python3
"""Turn Natural Earth land into SVG paths on an equirectangular grid.

Run once; the output is committed. The console needs coastlines and must not
fetch them at runtime - an isolated range should not depend on a CDN, and a
map that silently fails to load is worse than no map.

The projection is computed here rather than taken from a ready-made SVG on
purpose. Most world SVGs described as equirectangular are clipped somewhere
north of 83 and south of 56, so plotting a point with the textbook formula
lands it tens of pixels off. Doing the projection ourselves means the grid and
the points cannot disagree.

    bin/worldmap land-110m.json > platform/console/templates/console/world.svg
"""

from __future__ import annotations

import json
import sys

WIDTH, HEIGHT = 360.0, 180.0  # one unit per degree; viewBox "0 0 360 180"


def project(lon: float, lat: float) -> tuple[float, float]:
    """Plate carrée. The console plots points with exactly this formula."""
    return (lon + 180.0) / 360.0 * WIDTH, (90.0 - lat) / 180.0 * HEIGHT


def decode_arcs(topology: dict) -> list[list[tuple[float, float]]]:
    """Undo TopoJSON's quantisation and delta encoding."""
    scale = topology["transform"]["scale"]
    translate = topology["transform"]["translate"]
    decoded = []
    for arc in topology["arcs"]:
        x = y = 0
        points = []
        for dx, dy in arc:
            x += dx
            y += dy
            points.append(
                (x * scale[0] + translate[0], y * scale[1] + translate[1])
            )
        decoded.append(points)
    return decoded


def ring_points(arc_indices, arcs):
    points = []
    for index in arc_indices:
        arc = arcs[~index][::-1] if index < 0 else arcs[index]
        points.extend(arc[1:] if points else arc)
    return points


def path_for(ring, arcs) -> str:
    points = ring_points(ring, arcs)
    if len(points) < 3:
        return ""
    drawn = [f"M{x:.2f} {y:.2f}" for x, y in (project(*points[0]),)]
    drawn += [f"L{x:.2f} {y:.2f}" for x, y in (project(*p) for p in points[1:])]
    return "".join(drawn) + "Z"


def main() -> int:
    topology = json.load(open(sys.argv[1]))
    arcs = decode_arcs(topology)

    paths = []
    for geometry in topology["objects"]["land"]["geometries"]:
        polygons = (
            geometry["arcs"]
            if geometry["type"] == "MultiPolygon"
            else [geometry["arcs"]]
        )
        for polygon in polygons:
            for ring in polygon:
                drawn = path_for(ring, arcs)
                if drawn:
                    paths.append(drawn)

    print('<!-- Generated by bin/worldmap from Natural Earth 110m (public')
    print('     domain). Equirectangular, one unit per degree, so a point is')
    print('     x = lon + 180, y = 90 - lat. Do not edit by hand. -->')
    print("<g id=\"land\">", end="")
    print("".join(f'<path d="{d}"/>' for d in paths), end="")
    print("</g>")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
